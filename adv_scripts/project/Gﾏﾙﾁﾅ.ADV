	\L_076b0:
	\L_07624:
	ZM 32:
	'　　　　ゼス国'R
	ZM 24:
	R
	'サバサバ　［サクラ＆パスタ］'
	\L_07711:
	\L_07704:
	\L_075ec:
	'勝負だぁぁぁ！！'R
	'マルチナぁぁ！！'
	\L_07711:
	\L_07704:
	\L_0765c:
	'はい、望むところよ。'
	\L_07711:
	\L_07704:
	\L_075ec:
	'今日の対戦者は…'R
	'こいつだ！！'
	\L_07711:
	\L_07704:
*L_01428:
	IM VAR202, VAR203:
	{RND:
		@L_01428:
	}
	!VAR154 : 2!
	{VAR102 \ 0:
		$L_014f1$シィル$
	}
	$L_01a1f$マリス$
	!VAR154 : 12!
