		\L_04aac:
		\L_04994:
		'は？？'
		\L_04ab9:
		\L_04aac:
		\L_04a04:
		'金なんかどこにもなかったぞ。'
		\L_04ab9:
		\L_04aac:
		\L_04994:
		'馬鹿な！！'
		\L_04ab9:
		\L_04aac:
		\L_04a04:
		'本当だ。'R
