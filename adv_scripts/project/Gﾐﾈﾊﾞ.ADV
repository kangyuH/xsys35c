		\L_04ab9:
		\L_04aac:
		\L_04a04:
		'ああ…'
		\L_04ab9:
		\L_04aac:
		\L_04a66:
		!VAR516 : 424!
		\L_04a58:
		\L_04a04:
		'あれを使うつもりなのかい。'
		\L_04ab9:
		\L_04aac:
		\L_04994:
		'ああ、そうだ。'
		\L_04ab9:
		\L_04aac:
		\L_049cc:
