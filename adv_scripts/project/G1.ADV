	\L_06287:
	'ランス達は、サーレン山に'R
	'ピクニックに来た。'
	\L_06374:
	\L_06367:
	!VAR154 : 2!
	{VAR102 = 0:
		SS 5:
		!VAR516 : 1!
		\L_062a3:
		\L_0624f:
		'うーい。'R
		'いい天気じゃねぇか。'R
		'ヘルマン領内とは思えんぞ。'R
		'がはははは。'
		\L_06374:
		\L_06367:
		!VAR516 : 5!
		\L_06313:
		\L_062bf:
		'ダーリン。'R
		'あそこに、ほら。'R
		'ヒツジ飼いの女の子がいるよ。'
		\L_06374:
		\L_06367:
		\L_0624f:
		'うむ。'R
		'ではナンパしに行くとするか。'
		\L_06374:
		\L_06367:
		\L_062bf:
		'あん、駄目ぇ！'R
		'妻であるリアの前で、そんな事'R
		'しちゃいけないの。'
		\L_06374:
		\L_06367:
		{VAR58 \ 0:
			\L_06321:
			!VAR516 : 9!
			\L_06313:
			\L_062bf:
			'本当……'R
			'こんな所に来てまでがっつくのっ'R
			'て、みっともないわよ、ランス。'
			\L_06374:
			\L_06367:
			\L_06321:
			!VAR516 : 5!
			\L_06313:
		}
		\L_0624f:
		'ふん、つまらん。'
		\L_06374:
		'………お。'R
		'見ろ、リア。'R
		'なんか変な生き物がいるぞ。'R
		'がはははは。'
		\L_06374:
		\L_06367:
		\L_062bf:
		'あん、待ってよ、ダーリン！'
		\L_06374:
		\L_06367:
		{VAR58 \ 0:
			\L_06321:
			!VAR516 : 9!
			\L_06313:
			\L_062bf:
			'あ、リア様！'R
			'走ると危ないですよ！'
			\L_06374:
			\L_06367:
		}
		\L_06321:
		!VAR516 : 6!
		\L_06313:
		\L_062db:
		'良かった……'R
		'リア様、お幸せそう……'
		\L_06374:
		\L_06367:
		\L_06287:
		'ほのぼのとした夫婦生活を、マリ'R
		'スはうっとりとした目で眺めてい'R
		'た。'
		\L_06374:
		\L_06367:
		\L_06321:
		!VAR516 : 5!
		\L_06313:
		\L_062bf:
