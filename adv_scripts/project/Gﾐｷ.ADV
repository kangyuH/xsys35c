*L_057af:
	!VAR535 : 100!
	!VAR154 : 30!
	{VAR102 \ 0:
		!VAR102 : 0!
		\L_0b8b5:
		!VAR516 : 447!
		\L_0b8a7:
		\L_0b853:
		'……………'
		\L_0b908:
		\L_0b8fb:
		\L_0b7e3:
		'どうした、メガラス？'
		\L_0b908:
		\L_0b8fb:
		\L_0b853:
		'リトルプリンセス様がいなくなっ'R
		'た以上、私はここにいる必要はな'R
		'い。'
		\L_0b908:
		\L_0b8fb:
		\L_0b8b5:
		\L_0b88b:
		'メガラスはそう言うと、あっとい'R
		'う間に飛び去った。'
		\L_0b908:
		\L_0b8fb:
		!VAR516 : 6!
		\L_0b8a7:
		\L_0b853:
		'電光石火ですね…'
		\L_0b908:
		\L_0b8fb:
		\L_0b7e3:
		'自分の言いたい事だけ言って去っ'R
		'てたな…礼儀知らずめ。'
