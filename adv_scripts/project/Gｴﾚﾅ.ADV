	'こんな子を頂こうとしやがって。'
	\L_05519:
	\L_0550c:
	\L_053f4:
	'おい、お前ら！'
	\L_05519:
	\L_0550c:
	\L_054c6:
	!VAR516 : 260!
	\L_054b8:
	\L_05464:
	'はっ、はい！'
	\L_05519:
	\L_0550c:
	\L_053f4:
