	\L_13751:
	!VAR516 : 428!
	\L_136a9:
	\L_1368d:
	ZM 32:
	'　　山脈のアジト'R
	ZM 24:
	R
	'　　　カミーラ達の隠れ家'
	\L_1377a:
	\L_1376d:
	\L_13655:
	'ふふっ……'
	\L_1377a:
	'ふふふふ…'
	\L_1377a:
	\L_1376d:
	\L_1368d:
	'ずきずきと痛む躰にも関らず、'R
	'サイゼルはご機嫌だった。'
	\L_1377a:
	\L_1376d:
	\L_13655:
	'ざまぁみろ…ハウゼル…'R
	'あたしも痛かったけど、同じくら'R
	'い痛いはず…'
	\L_1377a:
	'一緒よ…ハウゼル…'R
	'あたしの痛み…'R
	'貴女の痛み……'
	\L_1377a:
	'ふふ……'
	\L_1377a:
	'ふふふふふ……'
	\L_1377a:
	\L_1376d:
	!VAR516 : 0!
	%#M.ADV:
	%0:
*L_0d68a:
	!VAR334 : 7!
	!VAR536 : 5!
	!VAR158 : 84!
