	PF0 VAR56:
	\L_1368d:
	'そしてその頃……'
	\L_1377a:
	ZM 32:
	'　　カスケードバウ'R
	ZM 24:
	R
	'　　　　　　戦場'
	\L_1377a:
	'攻めるケイブリス軍、守る'R
	'ホーネット軍の間で、'R
	'激しい戦いが繰り広げられて'R
	'いた。'
	\L_1377a:
	\L_1376d:
	!VAR520 : 6!
	%#FIGT表示.ADV:
	!VAR516 : 0!
