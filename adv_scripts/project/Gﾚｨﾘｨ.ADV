	\L_0609c:
	'そうだな、今日はレィリィを'R
	'呼ぼう。'
	\L_061a5:
	'あの一件以来、おとなくなった'R
	'しな。'
	\L_061a5:
	\L_06198:
	\L_060b8:
	R
	'………'
	\L_061a5:
	R
	'……'
	\L_061a5:
	R
	'…'
