	'今～リハビリ室に～…'
	\L_06df4:
	'ああ～…'
	\L_06df4:
	\L_06de7:
	\L_06ccf:
	'なんだ～？'
	\L_06df4:
	\L_06de7:
	\L_06d3f:
	'戻ってらっしゃいました～。'
	\L_06df4:
	\L_06de7:
	\L_06ccf:
	'ん～？'
	\L_06df4:
	\L_06de7:
	\L_06d77:
