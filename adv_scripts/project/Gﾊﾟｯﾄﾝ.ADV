	\L_08df8:
	!VAR516 : 1!
	\L_08d50:
	\L_08d34:
	ZM 32:
	'　　スードリ１３'R
	ZM 24:
	R
	'　　　　　前線司令部'
	\L_08e21:
	\L_08e14:
	\L_08cfc:
	'よし、次はここを攻めるぞ。'R
	'ヘルマンの反乱軍がいるらしいが'R
	'どっちにしろ俺の敵だ。叩く。'
	\L_08e21:
	\L_08e14:
	!VAR154 : 7!
	{VAR102 = 0:
		!VAR444 : 10!
		!VAR158 : D01!
