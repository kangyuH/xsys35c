	\L_02840:
	!VAR516 : 6!
	\L_027ec:
	\L_02798:
	'はい？'
	\L_0284d:
	\L_02840:
	\L_02728:
	'ＤＸの会を潰せ。'
	\L_0284d:
	\L_02840:
	\L_02798:
	'よろしいのですか？'
	\L_0284d:
	\L_02840:
	\L_02728:
	'かまわん。'
	\L_0284d:
	\L_02840:
	\L_02798:
	'わかりました。'R
	'さっそく手配します。'
	\L_0284d:
	\L_02840:
	\L_0278a:
	\L_027fa:
	\L_02760:
	'ランスが命じた通り、ランスの'R
