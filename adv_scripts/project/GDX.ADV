	\L_0284d:
	\L_02840:
	\L_02798:
	'そうですね……'
	\L_0284d:
	\L_02840:
	\L_027fa:
	!VAR516 : 5!
	\L_027ec:
	\L_02798:
	'じゃあ、グラック達が悪だったん'R
