		\L_06709:
		\L_06661:
		'ああ…空がまぶしく麗しいと'R
		'思って…'
		\L_06716:
		\L_06709:
		\L_065f1:
		'はあ…'
		\L_06716:
		\L_06709:
		\L_06661:
		'そう思いませんか？'
		\L_06716:
		\L_06709:
		\L_065f1:
