	'だからマリスも踊ろ。'R
	'ね？'
	\L_07f00:
	\L_07ef3:
	\L_07e9f:
	!VAR516 : 6!
	\L_07e91:
	\L_07e3d:
	'リ…リア様…'
	\L_07f00:
	\L_07ef3:
	\L_07de9:
	'きしし…こいつがこんなにうろた'R
