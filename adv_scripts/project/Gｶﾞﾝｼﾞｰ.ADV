	\L_0791b:
	'では、あちらのお茶屋に'R
	'参りましょうか。'
	\L_079d0:
	\L_079c3:
	\L_078ab:
	'うむ。'
	\L_079d0:
	\L_079c3:
	\L_078e3:
	'と、その時……'
