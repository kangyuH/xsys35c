	\L_02dc8:
	\L_02cb0:
	'どこが。'
	\L_02dd5:
	\L_02dc8:
	\L_02d82:
	!VAR516 : 80!
	\L_02d74:
	\L_02d20:
	'こいつは、儂の心のちんちんを'R
