	\L_05694:
	\L_055ec:
	'ああ…わかった…'R
	'すぐにやろう。'
	\L_056a1:
	\L_05694:
	\L_0557c:
	'ああ……'
	\L_056a1:
	\L_05694:
	\L_055b4:
