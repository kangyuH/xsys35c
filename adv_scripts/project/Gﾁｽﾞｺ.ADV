	{VAR336 = 7:
		!VAR516 : 52!
		\L_09da5:
		\L_09d51:
		'あの……本物……？の、'R
		'千鶴子様……'
		\L_09e06:
		'またリーザス軍が来ましたが、'R
		'御指示は、あの……'
		\L_09e06:
		\L_09df9:
		\L_09ce1:
		'そうね……'R
		'出撃の用意をする様、言って……'
		\L_09e06:
		\L_09df9:
		\L_09d51:
		'は、はッ。'
		\L_09e06:
		\L_09df9:
		\L_09db3:
		\L_09d19:
		'元気の無い千鶴子に'R
