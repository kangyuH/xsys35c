	ZM 32:
	'　　ケイブリス城'R
	ZM 24:
	R
	'　　　　　　地下牢'
	\L_05746:
	\L_05739:
	\L_05621:
	'酷いな…ここは……'
	\L_05746:
	\L_05739:
	\L_05691:
	'ああ、本当に…'
	\L_05746:
	\L_05739:
	\L_05659:
