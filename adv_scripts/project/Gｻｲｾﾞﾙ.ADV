	'魔人が何したって……'
	\L_05746:
	\L_05739:
	\L_05621:
	'……むむむ……'
	\L_05746:
	\L_05739:
	\L_056f3:
	!VAR516 : 429!
	\L_056e5:
	\L_05691:
	'ランス王……'R
