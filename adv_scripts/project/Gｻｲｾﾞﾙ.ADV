	\L_05746:
	\L_05739:
	\L_05691:
	'……はい……'
	\L_05746:
	\L_05739:
	\L_05621:
	'む～～……'
	\L_05746:
	\L_05739:
	\L_056f3:
	!VAR516 : 428!
	\L_056e5:
	\L_05691:
	'行くなって行っても、'R
	'行くもん。'
	\L_05746:
	\L_05739:
