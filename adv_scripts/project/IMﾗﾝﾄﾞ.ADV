	\L_0341b:
	R
	'………'
	\L_0341b:
	R
	'……'
	\L_0341b:
	R
	'…'
	\L_0341b:
	\L_0340e:
	\L_032f6:
	'ふう…疲れた。'
	\L_0341b:
	\L_0340e:
	\L_03366:
