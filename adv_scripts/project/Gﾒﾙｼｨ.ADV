	\L_031ec:
	\L_031df:
	\L_03137:
	'そっ……'
	\L_031ec:
	'そっ…'
	\L_031ec:
	'そんな…事…ないで…す…'
	\L_031ec:
	\L_031df:
	\L_030c7:
