		\L_0ee01:
		\L_0edf4:
		\L_0ed4c:
		'…………くだらない冗談は'R
		'やめて。'
		\L_0ee01:
		'私は……'
		\L_0ee01:
		'私は本気で……う……'
		\L_0ee01:
		'ひっく……'
		\L_0ee01:
		\L_0edf4:
		\L_0ecdc:
		'ああ、泣くな！！'R
		'もう！！'
		\L_0ee01:
