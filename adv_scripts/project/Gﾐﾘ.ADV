	}
	{VAR102 = 0:
		'マリス'
	}
	'が連れて来られた。'
	\L_05bba:
	!VAR154 : 2!
	{VAR102 \ 0:
		'シィル「あの…ランス様…きゃっ…」'
		\L_05bba:
	}
	{VAR102 = 0:
		'マリス「お呼びでしょうか、ランス王……」'
		\L_05bba:
	}
	!VAR154 : 2!
	{VAR102 \ 0:
		'シィルはミリ達の姿を見ると、あっという間に'R
		'真っ赤になった。'
		\L_05bba:
	}
	{VAR102 = 0:
		'マリスはミリ達の姿を見たが、冷静だ。'
		\L_05bba:
	}
	'ランス「嘗めろ」'
	\L_05bba:
	!VAR154 : 2!
	{VAR102 \ 0:
		'シィル「きゃっ…！！」'
		\L_05bba:
		'ハイパー兵器だけをぽろりとズボンから出している'R
		'ランスを見て、さらに悲鳴をあげるシィル。'
		\L_05bba:
