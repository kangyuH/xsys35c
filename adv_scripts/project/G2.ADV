	@L_0672e:
*L_06772:
	\L_0762e:
	'じゃ、ばいばいだ。'
	\L_07753:
	\L_07746:
	\L_0769e:
	'うん、ばいばい、また'R
	'来てね。'
	\L_07753:
	\L_07746:
	\L_07666:
	'少し寂しそうに手を振るウェン'R
	'リーナーをそこに置き、ランス'R
	'は去った。'
	\L_07753:
	\L_07746:
	\L_07690:
	\L_07700:
	SS 21:
	%0:
*L_06823:
	{VAR74 = VAR75:
