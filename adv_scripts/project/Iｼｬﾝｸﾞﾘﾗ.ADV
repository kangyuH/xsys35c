	'ひーひーうるさい！！'
	\L_082af:
	\L_082a2:
	\L_081c2:
	'　　＜ぐさっっっ＞'
	\L_082af:
	\L_082a2:
	\L_081fa:
	'ぎゃあああああ！！！'
	\L_082af:
	\L_082a2:
