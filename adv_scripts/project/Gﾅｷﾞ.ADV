	{(D01 = 1) * (VAR457 = 0):
		!VAR457 : 1!
		\L_0e762:
		'魔想志津香……'R
		'はい、おります。'
		\L_0e817:
		\L_0e80a:
		\L_0e6f2:
		'そうか……'R
		'来ているか……'
		\L_0e817:
		'魔想……志津香………'
