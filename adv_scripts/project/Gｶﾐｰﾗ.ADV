	\L_093d9:
	\L_093cc:
	\L_09316:
	\L_09324:
	'がぁぁぁぁ！！'
	\L_093d9:
	\L_093cc:
	\L_092ec:
	'　　＜ぐちゃっっっ＞'
	\L_093d9:
