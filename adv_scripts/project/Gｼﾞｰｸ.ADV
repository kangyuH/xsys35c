	\L_0388b:
	\L_03853:
	'よし…'R
	'今日は……'
	\L_0395c:
	\L_0394f:
	\L_038a7:
	'あ…ランス様…'
	\L_0395c:
	\L_0394f:
	\L_03837:
	'え？'
	\L_0395c:
