*L_07b84:
	!VAR560 : 13!
	!VAR417 : 1!
	!VAR516 : 0!
	%#M.ADV:
	!VAR516 : 1002!
	\L_08f01:
	!VAR516 : 1!
	\L_08e59:
	\L_08e3d:
	ZM 32:
	'　　　リーザス城'R
	ZM 24:
	R
	'　　　　ランスの寝室'
	\L_08f2a:
	'　　＜とんとん＞'
	\L_08f2a:
	\L_08f1d:
	\L_08e05:
	'いいぞ。'R
	'入れ。'
	\L_08f2a:
	\L_08f1d:
	!VAR516 : 11!
	\L_08ec9:
	\L_08e75:
	'失礼します…'
	\L_08f2a:
	\L_08f1d:
	\L_08e05:
	'よく来たな。'R
	'今日の用事は……'
	\L_08f2a:
	\L_08f1d:
	\L_08e3d:
	'ランスがベルトのバックルを'R
	'かちゃかちゃといわせながら、'R
	'用件を告げようとすると…'
	\L_08f2a:
	\L_08f1d:
	\L_08e75:
	'王様、私もご報告があります。'
	\L_08f2a:
	\L_08f1d:
	\L_08e05:
	'ん…なんだ？'R
	'先に聞こう。'
	\L_08f2a:
	\L_08f1d:
	\L_08e75:
	'はい、私……'R
	'結婚する事になりました。'
	\L_08f2a:
	\L_08f1d:
	\L_08e05:
	'結婚……ほう…'
	\L_08f2a:
	'……………'
	\L_08f2a:
	'ん？'R
	'なんだって！！！'
	\L_08f2a:
	\L_08f1d:
	\L_08e75:
	'結婚です…'
	\L_08f2a:
	'あの病気も治りましたので、'R
	'兼ねてからつき合っていた部下の'R
	'ブライトさんと……'R
	'来週、式をあげます。'
	\L_08f2a:
	'ランス王もよろしければ、'R
	'ご出席して頂きたいと……'
	\L_08f2a:
	\L_08f1d:
	\L_08e21:
	'がーーーーーーーーーーーーーー'R
	'ーーーーーーーーーーーーーーー'R
	'ーーーーーーーーーーーーーーー'R
	'ーーーーーーーーーーーーーん…'
	\L_08f2a:
	'なんてこったい…'
	\L_08f2a:
	\L_08f1d:
	\L_08e75:
	'あ…あの、王様？'
	\L_08f2a:
	\L_08f1d:
	\L_08e05:
	'ああ、わかった。'R
	'出席してやる。'R
	'歌でも隠し芸でも、なんでも'R
	'やってやろう。'
	\L_08f2a:
	\L_08f1d:
	\L_08e75:
	'ありがとうございます…'
	\L_08f2a:
	'あ…後…'R
	'王様のご用事は…？'
	\L_08f2a:
	\L_08f1d:
	\L_08e05:
	'………………'
	\L_08f2a:
	'忘れた。'R
	'だから、下がれ。'
	\L_08f2a:
	\L_08f1d:
	\L_08e75:
	'はい…ではまた思い出されたら、'R
	'お呼び下さい…失礼します…'
	\L_08f2a:
	\L_08f1d:
	\L_08ed7:
	\L_08ead:
	'メルフェイスはぺこりと頭を'R
	'下げると、ランスの部屋を出た。'
	\L_08f2a:
	\L_08f1d:
	\L_08e21:
	'………………'
	\L_08f2a:
	'……あ～～～あ……'
	\L_08f2a:
	'…勿体ない…勿体ない…'R
	'……しかし、やる気は失せて'R
	'しまった…'
	\L_08f2a:
	'思い出に最後…って'R
	'一発すれば良かったかなぁ…'R
	'あ～～～う～～……'
	\L_08f2a:
	\L_08f1d:
	!VAR516 : 0!
