	\L_04e99:
	\L_04d81:
	'むっ…むむ……'
	\L_04ea6:
	\L_04e99:
	\L_04db9:
	'シルキィの躰から溶けて出る様に'R
	{VAR359 = 2:
		'ひとつ'
	}
	{VAR359 = 3:
