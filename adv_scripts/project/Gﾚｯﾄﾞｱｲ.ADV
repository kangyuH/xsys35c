		\L_05e39:
		\L_05d21:
		'ちっ…'
		\L_05e46:
		\L_05e39:
		\L_05d91:
		'デンジャラス人物。'R
		'抹殺！'R
		'殺す・ユー！！'
		\L_05e46:
		'ファイヤーレーザー！！'
		\L_05e46:
		\L_05e39:
		\L_05d21:
		'きゃっ…！！'
		\L_05e46:
		\L_05e39:
		\L_05d83:
		\L_05d91:
		'あ…消えた…'R
		'ファッツ？'R
		'ロナ！'
		\L_05e46:
		\L_05e39:
		!VAR516 : 56!
		\L_05d75:
		\L_05d21:
		'は…はい！'
		\L_05e46:
		\L_05e39:
		\L_05d91:
