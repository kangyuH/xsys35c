	!VAR154 : 6!
	{VAR102 = 0:
		!VAR516 : 0!
		%#M.ADV:
		!VAR516 : 1046!
		\L_072cf:
		\L_0720b:
		ZM 32:
		'利萨斯城' R
		ZM 24:
		R
		'谒见之间'
		\L_072f8:
		\L_072eb:
		\L_071d3:
		'喂，玛莉丝。' R '叛军的……' R '那个，巴雷斯的女儿。'
		\L_072f8:
		\L_072eb:
		!VAR516 : 6!
		\L_07297:
		\L_07243:
		'您是说霍蕾恩副将吗？'
		\L_072f8:
		\L_072eb:
		\L_071d3:
		'对。' R '霍蕾恩怎么了？' R '还没找到吗？'
		\L_072f8:
		\L_072eb:
		\L_07243:
		'……已经发现了。'
		\L_072f8:
		\L_072eb:
		\L_071d3:
		'是吗。' R '那么，带到本大爷面前来……'
		\L_072f8:
		\L_072eb:
		\L_07243:
		'只是……'
		\L_072f8:
		'是尸体……'
		\L_072f8:
		\L_072eb:
		\L_071d3:
		'你说什么？'
		\L_072f8:
		\L_072eb:
		\L_07243:
		'据发现霍蕾恩副将的人说' R '，她似乎是自杀了' R '。'
		\L_072f8:
		\L_072eb:
		\L_071d3:
		'……………………'
		\L_072f8:
		'真是个做傻事的家伙。' R '跟她父亲一个样。'
		\L_072f8:
		'……………哼……'
		\L_072f8:
		'死了不就什么都做不了了吗' R '。' R '真没意思。'
		\L_072f8:
		\L_072eb:
		!VAR516 : 0!
