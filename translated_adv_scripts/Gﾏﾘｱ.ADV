	{VAR428 = 5:
		\L_09c0a:
		'现在正在开发郁金香１号改' R '。'
		\L_09cbf:
		'目前的开发进度是４０％。' R '希望能快点完成，完成后就配备到我的' R '部队里。'
		\L_09cbf:
		'这样的话，我的部队会变得非常' R '强哦。'
		\L_09cbf:
		\L_09cb2:
		@L_08211:
	}
	{VAR428 = 6:
		\L_09c0a:
		'郁金香１号改马上就要' R '完成了。'
		\L_09cbf:
		'与此同时正在开发的是郁' R '金香１００号。'
		\L_09cbf:
		\L_09cb2:
		\L_09b9a:
		'为什么突然变成１００了？' R '之前不是４吗。'
		\L_09cbf:
		\L_09cb2:
		\L_09c0a:
		'别在意细节。' R '因为这就是我的梦想。'
