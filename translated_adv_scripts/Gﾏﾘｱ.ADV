	{RND = 1:
*L_0928c:
		'兰斯（嗯。' R '　　　　　太棒了，太爽了。' R '　　　　　嘿嘿嘿嘿嘿嘿嘿嘿嘿嘿嘿）'
		\L_09cbf:
		'女孩１“啊，今天总觉得好累啊。”'
		\L_09cbf:
		'女孩２“嗯，是啊。' R '　　　　　对了，今天要不要去别处逛逛？”'
		\L_09cbf:
		'女孩３“那我想去啤酒花园。' R '　　　　　在累的时候咕嘟咕嘟地喝冰镇的' R '　　　　　感觉……”'
		\L_09cbf:
		'女孩１“诶———！' R '　　　　　我还想去咖啡店吃蛋糕套餐呢' R '　　　　　。”'
		\L_09cbf:
		'女孩２“我想去烤串店喝热酒……”'
		\L_09cbf:
		'女孩１“那个，绝对不行。”'
		\L_09cbf:
		'女孩３“我也是。”'
		\L_09cbf:
		'女孩２“诶——为什么，为什么啊！”'
		\L_09cbf:
		'女孩３“绝对是啤酒屋！”'
		\L_09cbf:
		'女孩１“蛋糕、蛋糕、蛋糕！！”'
		\L_09cbf:
		'女孩２“好……那么，猜拳吧！”'
		\L_09cbf:
		'女孩们“石头——剪刀——布！”'
		\L_09cbf:
		'兰斯（女孩子也有各种各样的事啊。' R '　　　　　嗯，学到了好东西。' R '　　　　　沙沙沙……记下来……）'
		\L_09cbf:
		'兰斯一边做笔记，一边离开了那个地方。'
		\L_09cbf:
		{VAR520 = 300:
			%0:
		}
	}
	{RND = 2:
		'女孩２“今天啊，保安福田君对我说，' R '　　　　　让我和他交往。”'
		\L_09cbf:
		'女孩１“诶————！！' R '　　　　　真好啊……”'
		\L_09cbf:
		'女孩３“……你……审美是不是哪里有问题？”'
		\L_09cbf:
		'女孩１“诶……可是福田君不是很普通吗。' R '　　　　　我觉得没什么不好啊……”'
		\L_09cbf:
		'女孩３“年轻的时候，眼光高一点' R '　　　　　也是可以被原谅的哦。”'
		\L_09cbf:
		'女孩３“反过来说，只有年轻的时候才能眼光高' R '　　　　　哦。”'
		\L_09cbf:
		'女孩２“这理论也相当苛刻啊……”'
		\L_09cbf:
		'女孩３“所以你……不交男朋友吗？”'
		\L_09cbf:
		'女孩３“我的事，怎么样都无所谓啦——！”'
		\L_09cbf:
		'女孩们“呀———！啊哈哈哈！”'
		\L_09cbf:
		'兰斯（……女孩子会在背后把男人说得一文不值' R '　　　　　吗……虽然早就知道……但看了还是胃痛' R '　　　　　……）'
		\L_09cbf:
		'兰斯揉着肚子，离开了那个地方。'
		\L_09cbf:
	}
	{RND = 3:
		'女孩２“喂，今天的早报看了吗？”'
		\L_09cbf:
		'女孩３“啊，打折的广告？”'
		\L_09cbf:
		'女孩２“对对！' R '　　　　　名牌商品打六折……' R '　　　　　简直像做梦一样……”'
		\L_09cbf:
		'女孩１“我好想去啊……”'
		\L_09cbf:
		'女孩２“那今天顺路去吗？”'
		\L_09cbf:
		'女孩３“是啊……' R '　　　　　那之后去喝酒吧。”'
		\L_09cbf:
		'女孩２“嗯，比起那个，去打保龄球' R '　　　　　吧。”'
		\L_09cbf:
		'女孩１“自动网球好……”'
		\L_09cbf:
		'女孩３“工作累得要死，还要去更耗体力的大甩卖' R '　　　　　……然后怎么可能还去运动' R '　　　　　啊！”'
		\L_09cbf:
		'女孩３“而且……就算钱花光了，' R '　　　　　在酒馆里勾搭一群男人，' R '　　　　　让他们买单不就行了。”'
		\L_09cbf:
		'女孩１“你还是那么会算计，省下酒钱' R '　　　　　啊～……”'
		\L_09cbf:
		'女孩３“哎呀，对方也是因为想认识女孩子' R '　　　　　才别有用心啊……”'
		\L_09cbf:
		'女孩３“我们不是填补了他们的寂寞吗。' R '　　　　　这不是五五开吗。”'
		\L_09cbf:
		'女孩３“而且，会被这种手段勾搭上的，' R '　　　　　大多都是随便赚点钱的大叔……' R '　　　　　所以良心不会太痛哦。”'
		\L_09cbf:
		'女孩２“我……想体验一下那种事……”'
		\L_09cbf:
		'女孩３“决定了！' R '　　　　　去喝酒吧———！”'
		\L_09cbf:
		'女孩１“啊……我……不去了……”'
		\L_09cbf:
		'女孩３“你在说什么啊。' R '　　　　　好了，先去大甩卖，然后去喝酒。”'
		\L_09cbf:
		'女孩１“呀———呀———！”'
		\L_09cbf:
		'兰斯（……女人……说不定是可怕的生物' R '……吗？）'
		\L_09cbf:
