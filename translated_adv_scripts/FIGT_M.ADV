	!VAR154 : 1!
	!VAR101 : 1!
	!VAR95 : 1358!
	!VAR96 : 1361!
	\L_0c1d9:
	'（卡奥斯）' R '…真是令人怀念的面孔啊。' R '我心中的色鬼朋友' R '们。'
	\L_0c23a:
	\L_0c22d:
	\L_0c185:
	'哈哈哈哈哈哈。' R '你看起来挺精神的嘛' R '卡奥斯。'
	\L_0c23a:
	'比起和那种家伙在一起' R '跟本大爷在一起更划算' R '哦！' R '来，过来吧！！'
	\L_0c23a:
	\L_0c22d:
	\L_0c1d9:
	'（卡奥斯）' R '是啊…'
	\L_0c23a:
	'（卡奥斯）' R '这个死脑筋，本大爷一' R '说黄段子就生气' R '，也不让我抱女人' R '，所以压力' R '一直积攒着' R '啊。'
	\L_0c23a:
	'（卡奥斯）' R '和你在一起的话' R '才能过上更好的人生' R '啊' R '。'
	\L_0c23a:
	\L_0c22d:
	\L_0c1d9:
	'什么？'
	\L_0c23a:
	\L_0c22d:
	\L_0c1d9:
	'（卡奥斯）' R '再见了，死脑筋。' R '我是个经不起快乐诱惑的' R '生物啊。'
	\L_0c23a:
	\L_0c22d:
	\L_0c1d9:
	'等等，卡奥斯！'
	\L_0c23a:
	\L_0c22d:
	\L_0c185:
	'哦呀。' R '你到我这边来了吗' R '卡奥斯。'
	\L_0c23a:
	'（卡奥斯）' R '呵呵呵呵，好久不' R '见啊…' R '你过得还好' R '吗？'
	\L_0c23a:
	\L_0c22d:
	\L_0c185:
	'啊，还行吧。' R '好。' R '我会好好使唤你的' R '卡奥斯。'
	\L_0c23a:
	\L_0c22d:
	\L_0c185:
	'（卡奥斯）' R '那也行，不过女人' R '得让我抱。' R '要漂亮的女人才行。'
	\L_0c23a:
	\L_0c22d:
	\L_0c185:
	'哈哈哈哈。' R '还是那么好色啊。' R '真是一把好剑。'
	\L_0c23a:
	\L_0c22d:
	\L_0c185:
	'（卡奥斯）' R '哼…别那么夸' R '我。'
	\L_0c23a:
	\L_0c22d:
	\L_0c1d9:
	'卡奥斯！' R '你这个叛徒……！'
	\L_0c23a:
	\L_0c22d:
	\L_0c185:
	'（卡奥斯）' R '不是人。' R '我是东西。'
	\L_0c23a:
	\L_0c22d:
	\L_0c185:
	'哈哈哈！！' R '哦——！！' R '上吧！！'
	\L_0c23a:
	\L_0c22d:
	\L_0c185:
	'（卡奥斯）' R '哦。' R '结束后，就是乱交' R '派对。'
	\L_0c23a:
	\L_0c22d:
	\0:
