*L_01b48:
	\L_02a29:
	@L_00253:
*L_01b52:
	{VAR519 < D03 - 1:
		\L_02a36:
		\L_02a29:
		\L_02911:
		'啊…钱不够。'
		\L_02a36:
		\L_02a29:
		\L_02981:
		'很遗憾，那样的话就不能卖给您' R '。'
		\L_02a36:
		'请从居民那里多榨取些，等钱攒够了' R '再来光顾' R '。'
		\L_02a36:
		\L_02a29:
		@L_019f4:
	}
*L_01bf5:
	IM VAR202, VAR203:
	{RND:
		@L_01bf5:
	}
	$L_01c23$购买$
	$L_01dee$不买$
	]
	@L_01bf5:
*L_01c23:
	!VAR519 : VAR519 - D03!
	!VAR166 : VAR166 + D03!
	!VAR160 : D04!
	!VAR150 : 100!
	{VAR160 = 19:
		!VAR467 : 1!
	}
	\L_02a29:
	\L_02911:
	'好，我买了。'
	\L_02a36:
	\L_02a29:
	\L_02981:
	'多谢惠顾～。'
	\L_02a36:
	'啊，啪啪。'
	\L_02a36:
	\L_02a29:
	\L_029b9:
	'普鲁贝特拍了拍手，他的部下从里面' R '搬来了木箱' R '。'
	\L_02a36:
	\L_02a29:
	\L_02981:
	'国王陛下购买的商品' R '就是这个。' R '您想怎么处理？'
	\L_02a36:
	\L_02a29:
	\L_02911:
	'放到对面的宝物库里去。'
	\L_02a36:
	\L_02a29:
	\L_02981:
	'明白了。'
	\L_02a36:
	'喂，你们，照国王说的做' R '。'
	\L_02a36:
	\L_02a29:
	\L_029b9:
	'普鲁贝特的部下们向宝物库' R '移动了。'
	\L_02a36:
	\L_02a29:
	\L_02981:
	'那么，您还需要别的什么吗' R '？'
	\L_02a36:
	\L_02a29:
	@L_019f4:
*L_01dee:
	\L_02a29:
	\L_02911:
	'果然还是不买了。'
	\L_02a36:
	\L_02a29:
	\L_02981:
	'诶～～～……'
	\L_02a36:
	'是吗……'
	\L_02a36:
	'是这样吗……'
	\L_02a36:
	'好不容易为国王准' R '备了那么多好东西…' R '…'
	\L_02a36:
	'呜……'
	\L_02a36:
	\L_02a29:
	@L_019f4:
*L_01e8a:
	!D03 : 1!
	!D04 : 19!
	\L_02a29:
	\L_029b9:
	'［洋装］' R '　适合希露的洋装' R '　特价　１０万ＧＯＬＤ'
	@L_01b52:
*L_01ed1:
	!D03 : 500!
	!D04 : 43!
	\L_02a29:
	\L_029b9:
	'［希拉米柠檬］' R '　传说的果实' R '　价格　５０００万ＧＯＬＤ'
	@L_01b52:
*L_01f1d:
	!D03 : VAR698!
	!D04 : 28!
	\L_02a29:
	\L_029b9:
	'［雾之卡］' R '　在战场上产生雾。' R '　价格　' H 0, VAR698: '０万ＧＯＬＤ'
	@L_01b52:
*L_01f6a:
	!D03 : 500!
	!D04 : 3!
	\L_02a29:
	\L_029b9:
	'［人望之杖］' R '　装备的角色升级时' R '　部下会聚集过来。' R '　　　特价　５０００万ＧＯＬＤ'
	@L_01b52:
*L_01fd4:
	!D03 : 1000!
	!D04 : 8!
	\L_02a29:
	\L_029b9:
	'［替身忍者］' R '　忍者快要被抓时' R '　代替被抓的人偶' R '　　特价　１００００万ＧＯＬＤ'
	@L_01b52:
*L_0203a:
	!D03 : 800!
	!D04 : 4!
	\L_02a29:
	\L_029b9:
	'［拿破仑之书］' R '　军团攻击力上升１。' R R '　　特价　８０００万ＧＯＬＤ'
	@L_01b52:
*L_02096:
	!D03 : 800!
	!D04 : 5!
	\L_02a29:
	\L_029b9:
	'［信玄之书］' R '　军团防御力上升１。' R R '　　特价　８０００万ＧＯＬＤ'
	@L_01b52:
*L_020ec:
	!D03 : 30!
	!D04 : 44!
	\L_02a29:
	\L_029b9:
	'［忍者捕鸟胶］' R '　捕获忍者、间谍' R R '　　　特价　３００万ＧＯＬＤ'
	@L_01b52:
*L_0213b:
	!VAR468 : 1!
	!VAR516 : 1!
	\L_02965:
	\L_0292d:
	'好，叫个商人来吧。'
	\L_02a36:
	\L_02a29:
	\L_02949:
	'兰斯命令叫商人来。'
	\L_02a36:
	'过了一会儿…'
	\L_02a36:
	\L_02a29:
	!VAR516 : D01!
	\L_029d5:
	\L_02949:
	'兰斯面前出现了一个可爱的女孩，带着人偶' R '。'
	\L_02a36:
	\L_02a29:
	\L_02911:
	'哦。' R '这样的女孩就是王室御用商人' R '吗。'
	\L_02a36:
	'看起来挺能干的，但带着人偶到处走' R '，还是个孩子' R '啊。'
	\L_02a36:
	\L_02a29:
	\L_02981:
	'人偶，难道是在说我' R '吗？'
	\L_02a36:
	\L_02a29:
	\L_02911:
	'………………诶？'
	\L_02a36:
	\L_02a29:
	\L_02981:
	'我是说，人偶是指我' R '吗。'
	\L_02a36:
	\L_02a29:
	\L_02911:
	'会说话的人偶吗？'
	\L_02a36:
	\L_02a29:
	\L_02981:
	'从刚才起您就太失礼了。' R '我可不是什么人偶' R '。'
	\L_02a36:
	'我是王室御用商人' R '普鲁贝特。' R '今后也请多多关照' R '，新国王陛下。'
	\L_02a36:
	\L_02a29:
	\L_029b9:
	'普鲁贝特滴溜溜地转了一圈' R '，然后低头行了一礼。'
	\L_02a36:
	\L_02a29:
	\L_02911:
	'旁边的是你女儿吗？'
	\L_02a36:
	\L_02a29:
	\L_02981:
	'啊，不是不是。'
	\L_02a36:
	'这姑娘叫蕾贝卡。' R '嗯，是我经营的商品' R '之一。'
	\L_02a36:
	\L_02a29:
	\L_02911:
	'这是商品？'
	\L_02a36:
	\L_02a29:
	\L_02981:
	'是的。' R '这是“福曼”姑娘。'
	\L_02a36:
	\L_02a29:
	\L_02911:
	'福曼？？'
	\L_02a36:
	\L_02a29:
	\L_02981:
	'是。' R '顺便一提，“曼”就是那个哔——' R '。'
	\L_02a36:
	'和这个蕾贝卡搞过的人' R '全都能变得幸福，是件好东西' R '。'
	\L_02a36:
	'当然，那方面也无可挑剔' R '。' R '在各种意义上都能上天堂，绝对没错' R '，老爷。'
	\L_02a36:
	\L_02a29:
	\L_029b9:
	'普鲁贝特嘻嘻嘻地' R '笑了。'
	\L_02a36:
	\L_02a29:
	\L_02981:
	'啊，如果您愿意，价格可以商量' R '。' R '毕竟莉娅公主也是老主顾' R '。'
	\L_02a36:
	'您是莉娅公主的丈夫' R '，所以…' R '服务，服务。'
	\L_02a36:
	\L_02a29:
	!VAR516 : 5!
	\L_029d5:
	\L_02981:
	'是吗。'
	\L_02a36:
	'莉娅也从普鲁佩特那里买了很多东西' R '。'
	\L_02a36:
	'虽然有点贵，但东西确实好。' R '亲爱的也买点什么吧？'
	\L_02a36:
	\L_02a29:
	!VAR516 : D01!
	\L_029d5:
	@L_00253:
*L_02636:
	!VAR468 : 4!
	!VAR516 : 1!
	\L_02965:
	\L_0292d:
	'好想买东西啊。'
	\L_02a36:
	'但是普鲁贝特已经死了…'
	\L_02a36:
	'好，任命一个新的御用商人' R '吧。' R '这次要女孩子。'
	\L_02a36:
	'用降价和进货数量来威胁她' R '，夺走她的身体也不错……'
	\L_02a36:
	'嗯嗯。' R '不错，不错。' R '嘿嘿。'
	\L_02a36:
	\L_02a29:
	\L_02911:
	'叫商人来。'
	\L_02a36:
	\L_02a29:
	\L_02949:
	'兰斯这么一说，过了一会儿' R '……'
	\L_02a36:
	\L_02a29:
	\L_02981:
	'欢迎光临～。'
	\L_02a36:
	\L_02a29:
	\L_0292d:
	'这个声音是…？'
	\L_02a36:
	\L_02a29:
	!VAR516 : D01!
	\L_029d5:
	\L_02981:
	'您叫我吗？' R '国王陛下。'
	\L_02a36:
	\L_02a29:
	\L_02911:
	'出、出现了，幽灵！'
	\L_02a36:
	\L_02a29:
	\L_02981:
	'不是啦。' R '我好好长着脚呢，' R '您看。'
	\L_02a36:
	\L_02a29:
	\L_02911:
	'嗯……虽然不知道能不能叫脚' R '……' R '确实。'
	\L_02a36:
	\L_02a29:
	\L_02981:
	'哎呀～，因为兰斯王对葡萄牙' R '发动了战争，可真是' R '够呛啊。'
	\L_02a36:
	'房子被烧了' R '，蕾贝卡也不知道去了哪里' R '……'
	\L_02a36:
	'不过靠隐藏的财产总算能重整旗鼓' R '。' R '今后也请多多关照' R '，国王陛下。'
	\L_02a36:
	\L_02a29:
	\L_02911:
	'没办法啊。' R '给我便宜点。'
	\L_02a36:
	\L_02a29:
	\L_02981:
	'嘿嘿。'
	\L_02a36:
	\L_02a29:
	@L_00253:
