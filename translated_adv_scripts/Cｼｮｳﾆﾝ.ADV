		$L_01f6a$人望之杖$
	}
	!VAR160 : 4!
	{VAR150 = 0:
		$L_0203a$拿破仑之书$
	}
	!VAR160 : 5!
	{VAR150 = 0:
		$L_02096$信玄之书$
	}
	!VAR160 : 44!
	{(VAR150 = 0) * (VAR586 = 3):
		$L_020ec$忍者捕鸟胶$
	}
	!VAR160 : 8!
	{VAR150 = 0:
		$L_01fd4$替身忍者$
	}
	!VAR160 : 19!
	!VAR154 : 2!
	{(VAR102 \ 0) * (VAR467 = 0) * (VAR150 = 0):
		$L_01e8a$洋装$
	}
	!VAR160 : 43!
	!VAR154 : 32!
	{(VAR102 \ 0) * (VAR150 = 0):
		$L_01ed1$希拉米柠檬$
	}
	!VAR160 : 28!
	{(VAR150 = 0) * (VAR698 \ 0):
		$L_01f1d$雾之卡$
	}
