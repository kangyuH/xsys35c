	!VAR154 : 14!
	{(VAR102 \ 0) * ((VAR569 = 14) + (VAR570 = 14) + (VAR571 = 14) + (VAR572 = 14)):
		!VAR383 : 1!
		!VAR516 : 1045!
		\L_038b5:
		\L_037f1:
		'［' X 8: '］' R R '利萨斯军前线基地'
		\L_038de:
		\L_038d1:
		!VAR516 : 405!
		\L_0380d:
		!VAR516 : 479!
		\L_0387d:
		\L_03829:
		'那是什么啊！！'
		\L_038de:
		'是怪物！！'
		\L_038de:
		'魔人，竟然那么大…' R '已经完蛋了！！'
		\L_038de:
		'哇啊啊啊……！！'
		\L_038de:
		\L_038d1:
		\L_03861:
		'士兵们被巴博拉的巨大所震慑' R '，像被灌了水的蚂蚁一样，' R '惊慌失措地乱跑起来' R '。'
		\L_038de:
		\L_038d1:
		\L_037f1:
		'＜啪！！＞'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'好了好了，各位。' R '冷静点。'
		\L_038de:
		\L_038d1:
		\L_037f1:
		'艾克斯用力拍了一下手，' R '用温柔的表情说道。'
		\L_038de:
		\L_038d1:
		\L_03829:
		'但……但是，艾克斯将军！' R '面对那么大的家伙……'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'大就是好事……' R '我可不这么认为。'
		\L_038de:
		\L_038d1:
		\L_03829:
		'诶……'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'正因为大，注意不到的东西' R '也有很多。'
		\L_038de:
		\L_038d1:
		\L_03829:
		'那……那该怎么办……'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'是啊……'
		\L_038de:
		\L_038d1:
		\L_037f1:
		'艾克斯用指尖轻轻敲了两三下下巴，' R '然后……'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'我们做个陷阱吧。' R '做个能让那巨大的身躯摔倒后动弹不得的' R '大家伙。'
		\L_038de:
		\L_038d1:
		\L_03829:
		'真是个恶劣的玩笑啊……' R '将军。'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'我可不是在开玩笑' R '哦。'
		\L_038de:
		'就算有点粗暴，从那个高度' R '也看不出来吧。' R '没关系，没关系。'
		\L_038de:
		\L_038d1:
		\L_03829:
		'哈啊……'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'所谓战斗，并不是只有从正面' R '互相碰撞才算本事' R '啊。'
		\L_038de:
		'是啊……好像要花钱' R '所以……' R '这件事，我马上' R '去拜托兰斯王吧。'
		\L_038de:
		'今天没办法……就让他按自己喜欢的方式' R '大闹一场吧。'
		\L_038de:
		'我们现在该做的是保护居民们的' R '生命。'
		\L_038de:
		'让居民们朝与巴博拉前进方向不同的方向' R '避难。请尽快' R '行动。'
		\L_038de:
		\L_038d1:
		\L_03829:
		'是……是！！'
		\L_038de:
		\L_038d1:
		!VAR516 : 0!
		%#M.ADV:
		!VAR382 : 2!
		%0:
	}
	!VAR154 : 15!
	{(VAR102 \ 0) * ((VAR569 = 15) + (VAR570 = 15) + (VAR571 = 15) + (VAR572 = 15)):
		!VAR383 : 2!
		!VAR516 : 1045!
		\L_038b5:
		\L_037f1:
		'［' X 8: '］' R R '利萨斯军前线基地'
		\L_038de:
		\L_038d1:
		!VAR516 : 413!
		\L_0380d:
		!VAR516 : 259!
		\L_0387d:
		\L_03829:
		'那是什么啊！！'
		\L_038de:
		'那种东西怎么可能存在！！'
		\L_038de:
		'这要怎么打啊！！' R '只会被踩扁！！'
		\L_038de:
		'哇啊……'
		\L_038de:
		'呀啊啊！！'
		\L_038de:
		\L_038d1:
		\L_03861:
		'士兵们被巴博拉的巨大体型和' R '破坏力所压倒，陷入恐慌' R '，争先恐后地拼命确保退路' R '。'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'擒抱————！！'
		\L_038de:
		\L_038d1:
		\L_03829:
		'呜哇啊啊啊！！？？'
		\L_038de:
		\L_038d1:
		\L_03861:
		'大约五名士兵成了篠田强行' R '擒抱的牺牲品，被撞飞' R '了。'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'别慌，各位！！'
		\L_038de:
		\L_038d1:
		\L_037f1:
		'篠田把被小依特制封套包住的球' R '高高举起，在倒下、昏' R '过去的士兵身上猛地站' R '了起来。'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'大块头算什么！！' R '有破坏力的家伙又算什么！！' R '这里有我的头脑，还有你们这' R '样优秀的人才！！'
		\L_038de:
		\L_038d1:
		\L_03829:
		'但是，篠田将军！！' R '要和那个交手什么的……'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'推不动的话，拉过来就好。'
		\L_038de:
		\L_038d1:
		\L_03829:
		'诶？'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'挖陷阱！！'
		\L_038de:
		\L_038d1:
		\L_03829:
		'陷……陷阱……' R '那个……在地上挖洞吗？？'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'没错。'
		\L_038de:
		\L_038d1:
		\L_03829:
		'可是……要挖出能坑掉那个大块头的' R '洞，那得……'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'有这么多人……是啊……' R '要是再要来些援军，马上' R '就能挖好吧。'
		\L_038de:
		\L_038d1:
		\L_03829:
		'……唉……'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'由我去向国王请求' R '吧。' R '好，就这么办，就这么办！'
		\L_038de:
		'好，就这么定了！！'
		\L_038de:
		\L_038d1:
		\L_03829:
		'……唉……'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'好，作战方案已定。' R '为了不白白增加尸体，我们' R '也先撤退吧。'
		\L_038de:
		\L_038d1:
		\L_037f1:
		'篠田挪动脚的时候，脚' R '下的士兵发出了像青蛙被踩扁一' R '样的轻微声音。'
		\L_038de:
		\L_038d1:
		\L_03845:
		'感觉已经……出来了……'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'来，我们走！' R '居民们也顺便救出来！'
		\L_038de:
		\L_038d1:
		\L_03829:
		'是……是！！'
		\L_038de:
		\L_038d1:
		!VAR516 : 0!
		%#M.ADV:
		!VAR382 : 2!
		%0:
	}
	!VAR154 : 28!
	{(VAR102 \ 0) * ((VAR569 = 28) + (VAR570 = 28) + (VAR571 = 28) + (VAR572 = 28)):
		!VAR383 : 3!
		!VAR516 : 1045!
		\L_038b5:
		\L_037f1:
		'［' X 8: '］' R R '利萨斯军前线基地'
		\L_038de:
		\L_038d1:
		!VAR516 : 26!
		\L_0380d:
		!VAR516 : 259!
		\L_0387d:
		\L_03829:
		'魔人到底是什么啊！！' R '那么大个……' R '这是欺诈！！'
		\L_038de:
		'咿咿咿咿！！'
		\L_038de:
		'好可怕啊！！'
		\L_038de:
		'快逃吧……'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'等一下。'
		\L_038de:
		\L_038d1:
		\L_03829:
		'啊……库莉姆将军！'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'我一个女人都这么冷静，' R '你们这些男人却慌慌张张，' R '成什么样子。'
		\L_038de:
		\L_038d1:
		\L_03829:
		'可……可是，那个……那个……'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'那种东西……' R '不就是个头大而已吗。' R '观察一下不就明白了？'
		\L_038de:
		'看……只是，只想着破坏' R '而已。' R '没有理论……也没有计划。' R '乱七八糟……无序至极。'
		\L_038de:
		\L_038d1:
		\L_03829:
		'……是……是啊……'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'也就是说……'
		\L_038de:
		'那家伙是个笨蛋。'
		\L_038de:
		\L_038d1:
		\L_03829:
		'啊？'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'给笨蛋设个合适的圈套' R '吧……是啊……'
		\L_038de:
		'那家伙掉进陷阱的样子……' R '想想就很有趣呢。'
		\L_038de:
		\L_038d1:
		\L_03829:
		'诶？？'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'是啊，那样就好。' R '嗯。' R '我的理论是完美的。'
		\L_038de:
		'联系兰斯王。' R '为了对付巴博拉，让他准备' R '陷阱……'
		\L_038de:
		\L_038d1:
		\L_03829:
		'我、我明白了。'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'啊，那边的你。'
		\L_038de:
		\L_038d1:
		\L_03829:
		'是、是！'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'把陷入恐慌的居民们' R '妥善地疏散。这样下去' R '的话，不是被巴博拉，而是被人类自己' R '害死的牺牲者恐怕会出现。'
		\L_038de:
		\L_038d1:
		\L_03829:
		'我……我明白了！！'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'呼……'
		\L_038de:
		'看着吧……' R '我会完成巨大魔人的纪念碑' R '给你看……呵呵……呵呵。'
		\L_038de:
		\L_038d1:
		!VAR516 : 0!
		%#M.ADV:
		!VAR382 : 2!
		%0:
	}
	!VAR154 : 35!
	{(VAR102 \ 0) * ((VAR569 = 35) + (VAR570 = 35) + (VAR571 = 35) + (VAR572 = 35)):
		!VAR383 : 4!
		!VAR516 : 1045!
		\L_038b5:
		\L_037f1:
		'［' X 8: '］' R R '利萨斯军前线基地'
		\L_038de:
		\L_038d1:
		!VAR516 : 77!
		\L_0380d:
		!VAR516 : 262!
		\L_0387d:
		\L_03829:
		'咿……！'
		\L_038de:
		'和那种东西正面战斗' R '怎么可能做得到！！'
		\L_038de:
		'好可怕啊！！' R '妈妈！！'
		\L_038de:
		'快逃啊！！'
		\L_038de:
		'不要啊！！'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'啊……等等……请……' R '大家……冷静下来……'
		\L_038de:
		'啊……！'
		\L_038de:
		\L_038d1:
		\L_03861:
		'阿尔克特被一个陷入恐慌' R '的士兵猛地撞到，' R '屁股重重地摔在了地上。'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'好……好痛……'
		\L_038de:
		\L_038d1:
		\L_03861:
		'虽然眼泪快要流出来了，但总算' R '忍住了。'
		\L_038de:
		\L_038d1:
		\L_03829:
		'您没事吧？' R '阿尔克特将军？'
		\L_038de:
		\L_038d1:
		\L_03861:
		'一名仍保持冷静的士兵' R '向阿尔克特' R '伸出了手。'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'啊……对不起……'
		\L_038de:
		\L_038d1:
		\L_03861:
		'或许是因为他人的温柔触动了内心，' R '阿尔克特扑簌簌地' R '掉下了眼泪。'
		\L_038de:
		\L_038d1:
		\L_03829:
		'将军，这里很危险。' R '请立刻撤退……'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'那……那个……'
		\L_038de:
		\L_038d1:
		\L_03829:
		'是？'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'我想和兰斯王取得联系' R '……那个……可以吗？'
		\L_038de:
		\L_038d1:
		\L_03829:
		'好的……大概……' R '怎么了？'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'啊……是的……' R '那个巨人……我想到了打倒巴博拉的方法' R '……'
		\L_038de:
		'似乎需要花费金钱……' R '所以……想向国王……'
		\L_038de:
		\L_038d1:
		\L_03829:
		'我明白了。' R '那么，请留言。'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'啊……好的……' R '为了打倒巴博拉，我觉得挖一个巨大的陷阱' R '就可以了……' R '为此需要资金和……人才……'
		\L_038de:
		\L_038d1:
		\L_03829:
		'陷……陷阱……'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'啊……不行……吗？'
		\L_038de:
		\L_038d1:
		\L_03829:
		'不，既然是将军的判断' R '，我想那样就可以了。'
		\L_038de:
		'我明白了。' R '我会传达的。'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'啊……拜托了……'
		\L_038de:
		'那个……还有……'
		\L_038de:
		\L_038d1:
		\L_03829:
		'是？'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'居民的避难……那个……' R '请帮忙……'
		\L_038de:
		\L_038d1:
		\L_03829:
		'我明白了。' R '那边我也会安排好的' R '。'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'好的……谢谢……' R '事事都麻烦您……对不起……'
		\L_038de:
		\L_038d1:
		\L_03829:
		'不，请别在意' R '。'
		\L_038de:
		\L_038d1:
		\L_037d5:
		'……但是……真的能用那个打倒' R '吗……'
		\L_038de:
		'如果打不倒的话……' R '…………该怎么办……'
		\L_038de:
		\L_038d1:
		!VAR516 : 0!
		%#M.ADV:
		!VAR382 : 2!
		%0:
	}
	!VAR154 : 6!
	{(VAR102 \ 0) * ((VAR569 = 6) + (VAR570 = 6) + (VAR571 = 6) + (VAR572 = 6)):
		!VAR383 : 5!
		!VAR516 : 1045!
		\L_038b5:
		\L_037f1:
		'［' X 8: '］' R R '利萨斯军前线基地'
		\L_038de:
		\L_038d1:
		!VAR516 : 402!
		\L_0380d:
		!VAR516 : 258!
		\L_0387d:
		\L_03829:
		'这个巨大的家伙是什么啊！！'
		\L_038de:
		'已经受够了！' R '妈妈——！！'
		\L_038de:
		'咿……咿——！！'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'喂，身为利萨斯的士兵' R '，面对只是块头大的怪物' R '，不要露出恐惧！！'
		\L_038de:
		\L_038d1:
		\L_037f1:
		'在悲鸣交响曲回响的战场上' R '，巴雷斯的一声大喝响彻四方。'
		\L_038de:
		\L_038d1:
		\L_03829:
		'啊……'
		\L_038de:
		'巴雷斯将军……'
		\L_038de:
		'非常抱歉……' R '那个……'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'不……你们能明白就好。' R '我才该为怒吼道歉' R '。'
		\L_038de:
		'与其慌张……' R '不如想想怎样才能收拾掉那家伙' R '，不是吗？'
		\L_038de:
		\L_038d1:
		\L_03829:
		'巴雷斯将军……' R '您有什么计策吗？'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'……嗯……'
		\L_038de:
		'成功还是失败……' R '五五开。'
		\L_038de:
		'挖个陷阱，试试让那家伙脚下踩空' R '，我觉得怎么样。'
		\L_038de:
		\L_038d1:
		\L_03829:
		'陷阱……吗？'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'没错……' R '巴博拉是个单纯的家伙。' R '单纯的陷阱反而更容易让他上钩' R '……我是这么想的。'
		\L_038de:
		\L_038d1:
		\L_03829:
		'原来如此……'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'今天先优先疏散居民' R '……取得兰斯王的许可后' R '立即执行作战。'
		\L_038de:
		\L_038d1:
		\L_03829:
		'是，明白了。' R '那么，我们集中精力进行避难。'
		\L_038de:
		\L_038d1:
		\L_037b9:
		'嗯。' R '就这么办。'
		\L_038de:
		\L_038d1:
		\L_037d5:
		'……今天……就让你闹腾吧' R '……下次可不会这样了' R '，巴博拉！'
		\L_038de:
		\L_038d1:
		\L_037f1:
		'巴雷斯狠狠地瞪着' R '正开心地大闹的巴博拉。'
		\L_038de:
		\L_038d1:
		!VAR516 : 0!
		%#M.ADV:
		!VAR382 : 2!
		%0:
	}
