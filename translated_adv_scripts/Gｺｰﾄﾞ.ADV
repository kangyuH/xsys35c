	\L_03154:
	\L_03100:
	'………………'
	\L_031b5:
	\L_031a8:
	\L_030c8:
	'科德屏住气息，站在了加奈美' R '身旁。'
	\L_031b5:
	\L_031a8:
	\L_03090:
	'………………'
	\L_031b5:
	\L_031a8:
	\L_03100:
	'…………'
	\L_031b5:
	\L_031a8:
	\L_03138:
