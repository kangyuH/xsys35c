	{D03 = 2:
		!D03 : 3!
		!VAR516 : 372!
		\L_0ed84:
		\L_0ed30:
		'哟。又来了吗？'
		\L_0ede5:
		\L_0edd8:
		\L_0ecc0:
		'什么，你在啊。' R '我还以为你死在旅途中了呢。'
		\L_0ede5:
		\L_0edd8:
		\L_0ed30:
		'别这么担心我。' R '我会害羞的。'
		\L_0ede5:
		\L_0edd8:
		\L_0ecc0:
		'我才没担心。' R '话说，终极女人' R '找到了吗？'
		\L_0ede5:
		\L_0edd8:
		\L_0ed30:
		'什么，你的目的就是这个吗。' R '我来介绍。' R '这是柴乃酱。'
		\L_0ede5:
		\L_0edd8:
		\L_0ecc0:
		'哦。'
		\L_0ede5:
		\L_0edd8:
		\L_0ed92:
		!VAR516 : 373!
		\L_0ed84:
		\L_0ed30:
		'对了，兰斯王。' R '要不要把哪个姑娘' R '寄放在我这里？'
		\L_0ede5:
		\L_0edd8:
		\L_0ecc0:
		'嘛，等等。让我和她谈谈。'
		\L_0ede5:
		\L_0edd8:
		\L_0ed30:
		'就像以前利萨斯的茱莉亚殿' R '在哈尼王大人身边修行' R '习得必杀技『哈尼闪光』' R '那样，'
		\L_0ede5:
		\L_0edd8:
		\L_0ecc0:
		'少骗人。'
		\L_0ede5:
		\L_0edd8:
		\L_0ed30:
		'如果让她在我这里修行，' R '就能学会有名的茶普茶普大人的必杀技' R '『硫酸投掷』' R '哦。'
		\L_0ede5:
		\L_0edd8:
		\L_0ecc0:
		'听人说话。'
		\L_0ede5:
		\L_0edd8:
		\L_0ed30:
		'而且那个女孩的学校泳装' R '还附带ｃｏｓｐｌａｙ。' R '呼。'
		\L_0ede5:
		\L_0edd8:
		\L_0ecc0:
		'啊啊，烦死了！' R '你别跟我说话！'
		\L_0ede5:
		\L_0edd8:
		\L_0ed30:
		'哦，已经这个时间了。' R '附近女校的放学时间到了' R '我先告辞了。'
		\L_0ede5:
		\L_0edd8:
		\L_0ed92:
		\L_0ecc0:
		'………………………总有一天杀了你。'
		\L_0ede5:
		\L_0edd8:
		\L_0ecf8:
		'兰斯移动到了' R '其他工作人员那里。'
		\L_0ede5:
		\L_0edd8:
	}
	{D03 = 1:
		!D03 : 2!
		!VAR516 : 372!
		\L_0ed84:
		\L_0ed30:
		'哦。' R '又来听我的说教' R '了吗？'
		\L_0ede5:
		\L_0edd8:
		\L_0ecc0:
		'什么说教。' R '变态。'
		\L_0ede5:
		\L_0edd8:
		\L_0ed30:
		'虽然很突然，但我要去旅行了。'
		\L_0ede5:
		\L_0edd8:
		\L_0ecc0:
		'真是突然啊。'
		\L_0ede5:
		\L_0edd8:
		\L_0ed30:
		'为了寻找理想的学校泳装女孩' R '我要踏上云游诸国的旅程。' R '别拦我。呼。'
		\L_0ede5:
		\L_0edd8:
		\L_0ecc0:
		'没人会拦你。'
		\L_0ede5:
		\L_0edd8:
		\L_0ed30:
		'那么再会。咻。'
		\L_0ede5:
		\L_0edd8:
		\L_0ed92:
		\L_0ecc0:
		'………………………………………' R '我也去别的地方吧。'
		\L_0ede5:
		\L_0edd8:
	}
	{D03 = 0:
		!D03 : 1!
		\L_0ecf8:
		'兰斯走到了' R '一只奇妙动物的旁边。'
		\L_0ede5:
		\L_0edd8:
		\L_0ecc0:
		'这是什么地方？'
		\L_0ede5:
		\L_0edd8:
		!VAR516 : 372!
		\L_0ed84:
		\L_0ed30:
		'我的名字是石草优太。' R '是随处可见的、稍微有点' R '喜欢学校泳装的' R '狸猫型怪物。呼。'
		\L_0ede5:
		\L_0edd8:
		\L_0ecc0:
		'………………………………………'
		\L_0ede5:
		\L_0edd8:
		\L_0ed30:
		'哎呀～，' R '最近托某款游戏的福' R '我也喜欢上袴了～。'
		\L_0ede5:
		\L_0edd8:
		\L_0ecc0:
		'………………………………………'
		\L_0ede5:
		\L_0edd8:
		\L_0ed30:
		'穿着袴的正统派美少女。' R '唔～☆' R '热情喷涌而出！！'
		\L_0ede5:
		\L_0edd8:
		\L_0ecc0:
		'………………………………………' R '………………………………………' R '………………………………………' R '…………………………回去了。'
		\L_0ede5:
		\L_0edd8:
		\L_0ed22:
		\L_0ed30:
		'在袴与学校泳装之间' R '摇摆不定的男人心与冬天的寒天。' R '真是硬派。呼。'
		\L_0ede5:
		\L_0edd8:
	}
