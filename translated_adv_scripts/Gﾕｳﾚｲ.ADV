	%0:
*L_01c80:
	!VAR516 : 0!
	%#M.ADV:
	!VAR516 : 1046!
	\L_04016:
	!VAR516 : 1!
	\L_03f6e:
	\L_03f52:
	ZM 32:
	'利萨斯城' R
	ZM 24:
	R
	'谒见之间'
	\L_0403f:
	\L_04032:
	\L_03f1a:
	'…………喂——，老板娘。'
	\L_0403f:
	\L_04032:
	\L_03f52:
	'＜啪啪＞'
	\L_0403f:
	'兰斯突然' R '拍了拍双手。'
	\L_0403f:
	\L_04032:
	!VAR516 : 6!
	\L_03fde:
	\L_03f8a:
	'兰斯王……' R '我不是老板娘。'
	\L_0403f:
	\L_04032:
	\L_03f1a:
	'哦，你很清楚嘛，' R '知道本大爷在叫你。'
	\L_0403f:
	\L_04032:
	\L_03f8a:
	'那个，大概……' R '请问有什么事吗？'
	\L_0403f:
	\L_04032:
	\L_03f1a:
	'嗯——，' R '巨大图书馆的书不够。'
	\L_0403f:
	\L_04032:
	\L_03f8a:
	'……哈啊……'
	\L_0403f:
	\L_04032:
	\L_03fa6:
	'……怎么突然说这个？'
	\L_0403f:
	\L_04032:
	\L_03f1a:
	'所以，我要增加书。'
	\L_0403f:
	\L_04032:
	\L_03f8a:
	'那倒是没问题……' R '幽灵骚动的事，' R '您打算怎么办？'
	\L_0403f:
	\L_04032:
	\L_03f1a:
	'嘛，等等。' R '本大爷自有打算，' R '总之先增加书。'
	\L_0403f:
	'那么……要增加的类别，' R '就选至今没有的类别。'
	\L_0403f:
	\L_04032:
	\L_03f8a:
	'至今没有的……？' R '要增加什么类别的书呢，' R '兰斯王？'
	\L_0403f:
	\L_04032:
*L_01f29:
