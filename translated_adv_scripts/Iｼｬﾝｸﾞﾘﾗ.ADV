	!VAR70 : 900!
	!VAR516 : 1027!
	\L_08286:
	!VAR516 : 1!
	\L_081de:
	\L_081a6:
	'可恶……' R '可恶啊啊啊啊！！！！'
	\L_082af:
	'不甘心啊，太不甘心了！！' R '你这个混蛋！！！'
	\L_082af:
	\L_082a2:
	!VAR516 : 6!
	\L_0824e:
	\L_081fa:
	'兰斯王。' R '这样下去的话…'
	\L_082af:
	\L_082a2:
	\L_0818a:
	'我知道！！'
	\L_082af:
	'全军撤退！！' R '回利萨斯！！'
	\L_082af:
	\L_082a2:
	!VAR516 : 0!
	%#M.ADV:
	!VAR158 : 1!
	!VAR45 : VAR142!
	!VAR46 : VAR143!
	!VAR516 : 1!
	%#M.ADV:
	!VAR43 : VAR45!
	!VAR44 : VAR46!
