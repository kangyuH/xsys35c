	!VAR690 : RND!
	{VAR690 = 1:
		!VAR516 : 0!
		%#M.ADV:
		!VAR516 : 1046!
		\L_015fd:
		!VAR516 : 1!
		\L_01555:
		!VAR516 : 424!
		\L_015c5:
		\L_01539:
		ZM 32:
		'利萨斯城' R
		ZM 24:
		R
		'谒见之间'
		\L_01626:
		\L_01619:
		\L_01571:
		'你找我有什么事吗？'
		\L_01626:
		\L_01619:
		\L_01501:
		'啊……有件事想问你。'
		\L_01626:
		'你真的喜欢巴顿' R '吗？'
		\L_01626:
		\L_01619:
		\L_01571:
		'……………'
		\L_01626:
		\L_01619:
		\L_01501:
		'如果不是的话，就到我身边' R '来吧。' R '我会好好珍惜你的。'
		\L_01626:
		\L_01619:
		\L_01571:
		'如果我说我喜欢巴顿' R '，你就会干脆放弃吗？'
		\L_01626:
		\L_01619:
		\L_01501:
		'好男人不会强人所难' R '的。'
		\L_01626:
		\L_01619:
		\L_01571:
		'这样啊……'
		\L_01626:
		'那么，希望你放弃……'
		\L_01626:
		\L_01619:
		\L_0151d:
		'果然还是这样啊。'
		\L_01626:
		\L_01619:
		\L_01501:
		'那么……'
		\L_01626:
		'就一次，让我上你吧。' R '我会带你上天堂的。' R '嘎哈哈哈哈。'
		\L_01626:
		\L_01619:
		\L_01571:
		'死也不要。'
		\L_01626:
		\L_01619:
		\L_01501:
		'就算巴顿会怎么样' R '也无所谓吗？'
		\L_01626:
		\L_01619:
		\L_01571:
		'直到我带着巴顿离开这里' R '为止！'
		\L_01626:
		\L_01619:
		\L_015d3:
		!VAR516 : 6!
		\L_015c5:
		\L_01571:
		'兰斯王……'
		\L_01626:
		\L_01619:
		\L_01539:
		'玛莉丝对兰斯耳语。'
		\L_01626:
		\L_01619:
		\L_01571:
		'根据调查……她拥有' R '瞬间移动能力。' R '所以，无论发生什么，她似乎都能' R '逃走……'
		\L_01626:
		\L_01619:
		\L_01501:
		'那家伙真麻烦啊……'
		\L_01626:
		\L_01619:
		\L_01571:
		'所以，现在……' R '巴顿大人的军队与我们为敌，' R '对我们来说也不是什么好事' R '……'
		\L_01626:
		\L_01619:
		\L_01501:
		'嗯。'
		\L_01626:
		'汉蒂。'
		\L_01626:
		\L_01619:
		\L_015d3:
		!VAR516 : 424!
		\L_015c5:
		\L_01571:
		'什么事？'
		\L_01626:
		\L_01619:
		\L_01501:
		'刚才那是骗你的。' R '我只是试探一下你对巴顿' R '是怎么想的。'
		\L_01626:
		\L_01619:
		\L_01571:
		'我不太喜欢恶劣的玩笑' R '。'
		\L_01626:
		'希望你不要用那种事来试探我。' R '我对巴顿的感情……' R '不是人类能够理解的' R '。'
		\L_01626:
		\L_01619:
		\L_01501:
		'不不。' R '如果是身为英雄的我，就能理解' R '你。'
		\L_01626:
		\L_01619:
		\L_01571:
		'………………'
		\L_01626:
		\L_01619:
		\L_015d3:
		\L_015a9:
		'汉蒂什么也没说，快步' R '从宝座前离开了。'
		\L_01626:
		\L_01619:
		\L_01501:
		'喂，站住！' R '谁说你可以走了！！'
		\L_01626:
		\L_01619:
		!VAR516 : 6!
		\L_015c5:
		\L_01571:
		'兰斯王……' R '她是不是在表示不想谈论自己的心情' R '呢' R '……？'
		\L_01626:
		\L_01619:
		\L_01501:
		'真是的……真是个野丫头！' R '嘟嘟囔囔……'
		\L_01626:
		\L_01619:
		!VAR516 : 0!
		%#M.ADV:
		%0:
	}
	{VAR690 = 2:
		!VAR516 : 0!
		%#M.ADV:
		!VAR516 : 1046!
		\L_015fd:
		!VAR516 : 1!
		\L_01555:
		!VAR516 : 424!
		\L_015c5:
		\L_01539:
		ZM 32:
		'利萨斯城' R
		ZM 24:
		R
		'谒见之间'
		\L_01626:
		\L_01619:
		\L_01571:
		'什么事？'
		\L_01626:
		\L_01619:
		\L_01539:
		'被兰斯叫来，汉蒂' R '来了。'
		\L_01626:
		\L_01619:
		\L_01501:
		'喂……你是处女吧。' R '因为水晶的颜色是红色的。'
		\L_01626:
		'卡拉的颜色真方便啊。' R '那种事一目了然。' R '嘎哈哈哈哈。'
		\L_01626:
		\L_01619:
		\L_01571:
		'卡拉是处女，没什么好奇怪的' R '吧。' R '守护贞洁是卡拉最重要' R '的事。'
		\L_01626:
		\L_01619:
		\L_01501:
		'人类的女人就不是这样' R '吗？'
		\L_01626:
		\L_01619:
		\L_01571:
		'我不是那个意思' R '！'
		\L_01626:
		\L_01619:
		\L_01501:
		'说来说去，你是为了巴顿' R '才保留的吧。'
		\L_01626:
		\L_01619:
		\L_01571:
		'笨蛋！！！！！'
		\L_01626:
		\L_01619:
		\L_015d3:
		\L_015a9:
		'汉蒂大声说完，' R '气冲冲地离开了。'
		\L_01626:
		\L_01619:
		\L_01501:
		'……被我说中了吗……？'
		\L_01626:
		\L_01619:
		!VAR516 : 6!
		\L_015c5:
		\L_01571:
		'她打算和巴顿大人也不发生关系' R '。'
		\L_01626:
		\L_01619:
		\L_01501:
		'是汉蒂这么说的吗？'
		\L_01626:
		\L_01619:
		\L_01571:
		'不是。'
		\L_01626:
		\L_01619:
		\L_01501:
		'那你怎么知道？'
		\L_01626:
		\L_01619:
		\L_01571:
		'只是感觉……' R '有想保持那种关系的男性' R '也不奇怪吧……'
		\L_01626:
		\L_01619:
		\L_01501:
		'我不明白。'
		\L_01626:
		\L_01619:
		\L_01571:
		'这样就好。' R '要是您说您明白，我' R '会立刻叫医生来的。'
		\L_01626:
		\L_01619:
		\L_01501:
		'你这是在夸我' R '还是在损我？'
		\L_01626:
		\L_01619:
		\L_01571:
		'都不是哦……' R '呵呵……'
		\L_01626:
		\L_01619:
		\L_01501:
		'哼！' R '女人总是马上集体欺负男人' R '……真不像话。'
		\L_01626:
		\L_01619:
		!VAR516 : 0!
		%#M.ADV:
		%0:
	}
	{VAR690 = 3:
		!VAR516 : 0!
		%#M.ADV:
		!VAR516 : 1046!
		\L_015fd:
		!VAR516 : 1!
		\L_01555:
		\L_01539:
		ZM 32:
		'利萨斯城' R
		ZM 24:
		R
		'谒见之间'
		\L_01626:
		'兰斯让部下去叫汉蒂' R '，自己在宝座上等着。'
		\L_01626:
		\L_01619:
		\L_01501:
		'……嗯？'
		\L_01626:
		\L_01619:
		!VAR516 : 423!
		\L_015c5:
		\L_01539:
		'一看，巴顿在柱子后面' R '东张西望。'
		\L_01626:
		\L_01619:
		\L_01501:
		'你在干什么？' R '我没叫你吧，' R '巴顿。'
		\L_01626:
		\L_01619:
		\L_01571:
		'呃，啊，不，我以为汉蒂来' R '这里了……'
		\L_01626:
		\L_01619:
		\L_01501:
		'啊，我是叫了。' R '叫了，但她不来……' R '难道她打算无视我' R '吗……'
		\L_01626:
		'话说回来，你有什么事' R '吗？'
		\L_01626:
		\L_01619:
		\L_01571:
		'不，不，没什么大不了的' R '。' R '真的……'
		\L_01626:
		\L_01619:
		\L_015d3:
		\L_015a9:
		'巴顿一边说着，一边再次' R '东张西望，一副心神不宁' R '的样子，离开了那里。'
		\L_01626:
		\L_01619:
		\L_01501:
		'怎么回事……？'
		\L_01626:
		\L_01619:
		!VAR516 : 6!
		\L_015c5:
		\L_01571:
		'恐怕是担心汉蒂大人' R '，所以来看看情况的' R '吧。'
		\L_01626:
		\L_01619:
		\L_01501:
		'只是被我叫来，有什么好担心的' R '？'
		\L_01626:
		\L_01619:
		\L_01571:
		'那当然是各种……'
		\L_01626:
		\L_01619:
		\L_01501:
		'所以，你说的各种是……'
		\L_01626:
		\L_01619:
		\L_01571:
		'啊，我想起来我还有事' R '……'
		\L_01626:
		\L_01619:
		\L_015d3:
		\L_01501:
		'玛——莉——丝！！'
		\L_01626:
		\L_01619:
		\L_01539:
		R
		'………'
		\L_01626:
		R
		'……'
		\L_01626:
		R
		'…'
		\L_01626:
		'之后一个小时……' R '汉蒂没有出现。'
		\L_01626:
		\L_01619:
		\L_01501:
		'可恶！！' R '你把我当什么了！' R '我可是国王啊！！'
		\L_01626:
		\L_01619:
		\L_01539:
		'兰斯在宝座上大声怒吼' R '。'
		\L_01626:
		\L_01619:
		!VAR516 : 471!
		\L_015c5:
		\L_01571:
		'失……失礼了！！'
		\L_01626:
		\L_01619:
		\L_015a9:
		'一个气喘吁吁的部下出现在兰斯面前' R '。'
		\L_01626:
		\L_01619:
		\L_01501:
		'你是……' R '我派去叫汉蒂的家伙' R '吧。'
		\L_01626:
		\L_01619:
		\L_01571:
		'兰……兰斯王……' R '哪里都找不到汉蒂大人' R '……呼……呼……'
		\L_01626:
		\L_01619:
		\L_01501:
		'你……你……' R '……一直找到现在吗……'
		\L_01626:
		\L_01619:
		\L_01571:
		'是的……？'
		\L_01626:
		\L_01619:
		\L_01501:
		'哈啊……算了……'
		\L_01626:
		\L_01619:
		\L_01571:
		'哈啊……'
		\L_01626:
		\L_01619:
		\L_0151d:
		'哼……没兴致了……'
		\L_01626:
		\L_01619:
		!VAR516 : 0!
		%#M.ADV:
		%0:
	}
	{VAR690 = 4:
		!VAR516 : 0!
		%#M.ADV:
		!VAR516 : 1046!
		\L_015fd:
		!VAR516 : 1!
		\L_01555:
		!VAR516 : 424!
		\L_015c5:
		\L_01539:
		ZM 32:
		'利萨斯城' R
		ZM 24:
		R
		'谒见之间'
		\L_01626:
		'汉蒂站在兰斯面前。'
		\L_01626:
		\L_01619:
		\L_01501:
		'直截了当！！'
		\L_01626:
		\L_01619:
		\L_01539:
		'＜咻！＞'
		\L_01626:
		'兰斯指向汉蒂。'
		\L_01626:
		\L_01619:
		\L_01571:
		'没礼貌哦。' R '用手指着别人。'
		\L_01626:
		\L_01619:
		\L_01501:
		'闭嘴。' R '你是打算和赫尔曼皇帝结婚' R '成为赫尔曼的皇后吧' R '。'
		\L_01626:
		\L_01619:
		\L_01571:
		'结婚？' R '啊哈哈，卡拉怎么可能和人类结婚' R '。'
		\L_01626:
		\L_01619:
		\L_01501:
		'为什么？' R '如果是我的话，不会在意那种事。'
		\L_01626:
		\L_01619:
		\L_01571:
		'面对不知道什么时候会离开这片大地的种族' R '，现实的话题是没有意义的' R '。'
		\L_01626:
		\L_01619:
		\L_01501:
		'是叫觉醒吗……？' R '确实那样的话，可能当不了好妻子' R '。'
		\L_01626:
		\L_01619:
		\L_01571:
		'就是这么回事。'
		\L_01626:
		'……不过，我有点高兴。'
		\L_01626:
		\L_01619:
		\L_01501:
		'高兴什么？'
		\L_01626:
		\L_01619:
		\L_01571:
		'我啊，最喜欢“我不在意”这句话' R '了。'
		\L_01626:
		\L_01619:
		\L_01501:
		'嗯？' R '那种话有什么好的。'
		\L_01626:
		\L_01619:
		\L_01571:
		'……巴顿小时候，也对我说过同样的话' R '……'
		\L_01626:
		\L_01619:
		\L_01501:
		'……………'
		\L_01626:
		'从今以后，只要你在场，我绝不说“我不在意”' R '。'
		\L_01626:
		\L_01619:
		\L_01571:
		'那算什么啊……' R '随你便。'
		\L_01626:
		\L_01619:
		\L_01501:
		'哼，我随我自己的便。'
		\L_01626:
		\L_01619:
		\L_015d3:
		!VAR516 : 6!
		\L_015c5:
		\L_0158d:
		'……小孩子……'
		\L_01626:
		\L_01619:
		!VAR516 : 0!
		%#M.ADV:
		%0:
	}
