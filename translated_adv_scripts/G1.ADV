	\L_04e00:
*L_00ca6:
	'兰斯“去～森林～吧～。' R '　　　　小姑娘～。' R '　　　　嘿嘿嘿”'
	\L_04e45:
	'希露“兰斯大人……歌词好像有点不对……”'
	\L_04e45:
	'兰斯“吵死了。' R '　　　　这样就行”'
	\L_04e45:
	'兰斯“比起那个，希露，要好好搬便当' R '　　　　哦。' R '　　　　掉了的话，就打你屁股”'
	\L_04e45:
	'希露“是，兰斯大人……嘿咻……嘿咻……”'
	\L_04e45:
	'希露拼命搬着塞满５人份便当的午餐盒' R '，看入了迷周围的景色。'
	\L_04e45:
	'希露“好美……真是个好地方呢，兰斯大人”'
	\L_04e45:
	'兰斯“嗯，正适合打野战”'
	\L_04e45:
	'希露“啊……啊哈哈……”'
	\L_04e45:
	'莉娅“亲爱的！' R '　　　快看快看！！' R '　　　小河！！我们去抓鱼吧！”'
	\L_04e45:
	'兰斯“嗯。' R '　　　　本大爷要捡贝壳。' R '　　　　鱼你自己去抓”'
	\L_04e45:
	'莉娅“噗！' R '　　　那莉娅也要捡贝壳！' R '　　　好想要樱花贝啊”'
	\L_04e45:
	'兰斯“樱花贝是本大爷的。' R '　　　　莉娅有蚬贝就够了”'
	\L_04e45:
	'莉娅“真是的，坏心眼，坏心眼！”'
	\L_04e45:
	'兰斯“哈哈哈！”'
	\L_04e45:
	'兰斯“嗯？怎么了？玛莉丝。' R '　　　　一脸不高兴……”'
	\L_04e45:
	'玛莉丝“不……没什么……”'
	\L_04e45:
	'玛莉丝（哈……为什么来野餐还要' R '　　　　拿着这种旗子……）'
	\L_04e45:
	'兰斯“好好把旗子举高。' R '　　　　得炫耀一下国王就在这里。' R '　　　　哈哈哈！！”'
	\L_04e45:
	'玛莉丝“好好”'
	\L_04e45:
	'莉娅“啊，春卷！' R '　　　有鸟在飞哦！”'
	\L_04e45:
	'春卷“嘎哦嘎哦”'
	\L_04e45:
	'莉娅“亲爱的，春卷也很开心呢”'
	\L_04e45:
	'兰斯“哼哼。' R '　　　　区区畜生居然也懂得开心。' R '　　　　哈哈哈”'
	\L_04e45:
	'莉娅“春卷也可以飞哦。' R '　　　去吧！”'
	\L_04e45:
	'春卷“嘎嗷呜呜呜”'
	\L_04e45:
	'莉娅“呵呵。' R '　　　春卷你呀，怎么发出这么没出息的声音”'
	\L_04e45:
	'兰斯“好，就在这附近吃便当吧。' R '　　　　希露，准备一下”'
	\L_04e45:
	'希露“是，兰斯大人”'
	\L_04e45:
	'兰斯“应该有带粉红乌纽恩' R '　　　　吧？”'
	\L_04e45:
	'希露“是的，我带了兰斯大人喜欢的冰得透心凉的' R '　　　　来哦。请用”'
	\L_04e45:
	'兰斯“嗯……咕嘟……咕嘟……咕嘟……' R '　　　　呼～～……好喝！！”'
	\L_04e45:
	'莉娅“奴隶，莉娅的呢？”'
	\L_04e45:
	'希露“啊，请用，莉娅大人”'
	\L_04e45:
	'莉娅“嗯……真好喝呢，亲爱的”'
	\L_04e45:
	'兰斯“哦”'
	\L_04e45:
	'希露“玛莉丝大人也……”'
	\L_04e45:
	'玛莉丝“谢谢”'
	\L_04e45:
	'希露“那个……兰斯大人……我也可以喝' R '　　　　吗？”'
	\L_04e45:
	'兰斯“你喝水”'
	\L_04e45:
	'希露“……呜……”'
	\L_04e45:
	{VAR520 = 300:
		%0:
	}
	!VAR154 : 6!
	{VAR102 \ 0:
		'巴雷斯“兰斯大人，对面有棵很棒的松树' R '　　　　哦。' R '　　　　要去看看吗？”'
		\L_04e45:
		'兰斯“喂，玛莉丝！！' R '　　　　谁让你带巴雷斯来的？？”'
		\L_04e45:
	}
