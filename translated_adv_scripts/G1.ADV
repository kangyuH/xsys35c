	Y 4, 3:
	!VAR690 : RND!
	{VAR690 = 1:
		\L_04d20:
		'话说，你……' R '是不是在哪里见过？'
		\L_04e45:
		\L_04e38:
		\L_04d90:
		'在哪里，是哪里呢？'
		\L_04e45:
		\L_04e38:
		\L_04d20:
		'嗯——……想不起来。' R '占卜一下，或者，让我想起来。'
		\L_04e45:
		\L_04e38:
		\L_04d90:
		'不行。' R '要占卜的话给我点心。' R '嘻嘻……'
		\L_04e45:
		\L_04e38:
		\L_04d20:
		'唔……可疑的家伙。'
		\L_04e45:
		\L_04e38:
	}
	{VAR690 = 2:
		\L_04d20:
		'你……为什么' R '一个人在这种地方？' R '很危险吧。'
		\L_04e45:
		'最近有变态萝莉控，' R '就算是小孩子也不能放心。' R '我可不是。'
		\L_04e45:
		\L_04e38:
		\L_04d90:
		'没关系。' R '因为我是占卜到安全的地方' R '才来的。'
		\L_04e45:
		\L_04e38:
		\L_04d20:
		'所以就是这里吗？' R '安全吗？'
		\L_04e45:
		\L_04e38:
		\L_04d90:
		'是啊，比城市里更安心。'
		\L_04e45:
		\L_04e38:
	}
	{VAR690 = 3:
		\L_04d20:
		'仔细看看……好小啊。' R '几岁了？'
		\L_04e45:
		\L_04e38:
		\L_04d90:
		'哥哥，' R '问女士年龄很失礼哦。' R '哼。'
		\L_04e45:
		\L_04e38:
		\L_04d20:
		'谁是蕾蒂，谁。' R '等十年后再说吧。'
		\L_04e45:
		\L_04e38:
		\L_04d90:
		'十年？' R '嘻嘻……'
		\L_04e45:
		\L_04e38:
	}
	@L_0269f:
