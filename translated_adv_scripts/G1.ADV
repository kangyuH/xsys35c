*L_00996:
	!VAR516 : 0!
	%#M.ADV:
	!VAR516 : 1030!
	\L_04e1c:
	\L_04d58:
	'兰斯他们来萨伦山' R '野餐了。'
	\L_04e45:
	\L_04e38:
	!VAR154 : 2!
	{VAR102 = 0:
		SS 5:
		!VAR516 : 1!
		\L_04d74:
		\L_04d20:
		'嗯。' R '天气真好啊。' R '真不敢相信这是赫尔曼境内。' R '哈哈哈。'
		\L_04e45:
		\L_04e38:
		!VAR516 : 5!
		\L_04de4:
		\L_04d90:
		'亲爱的。' R '那里，你看。' R '有个牧羊的女孩哦。'
		\L_04e45:
		\L_04e38:
		\L_04d20:
		'嗯。' R '那去搭讪一下吧。'
		\L_04e45:
		\L_04e38:
		\L_04d90:
		'啊，不行！' R '在妻子莉娅面前，不能做那种事' R '。'
		\L_04e45:
		\L_04e38:
		{VAR58 \ 0:
			\L_04df2:
			!VAR516 : 9!
			\L_04de4:
			\L_04d90:
			'真是的……' R '都到这种地方了还这么猴急' R '，太难看了，兰斯。'
			\L_04e45:
			\L_04e38:
			\L_04df2:
			!VAR516 : 5!
			\L_04de4:
		}
		\L_04d20:
		'哼，无聊。'
		\L_04e45:
		'……哦。' R '看，莉娅。' R '有只奇怪的生物哦。' R '哈哈哈。'
		\L_04e45:
		\L_04e38:
		\L_04d90:
		'啊，等等我，亲爱的！'
		\L_04e45:
		\L_04e38:
		{VAR58 \ 0:
			\L_04df2:
			!VAR516 : 9!
			\L_04de4:
			\L_04d90:
			'啊，莉娅大人！' R '跑起来很危险哦！'
			\L_04e45:
			\L_04e38:
		}
		\L_04df2:
		!VAR516 : 6!
		\L_04de4:
		\L_04dac:
		'太好了……' R '莉娅大人，看起来很幸福……'
		\L_04e45:
		\L_04e38:
		\L_04d58:
		'玛莉丝用陶醉的眼神' R '望着这温馨的夫妻生活' R '。'
		\L_04e45:
		\L_04e38:
		\L_04df2:
		!VAR516 : 5!
		\L_04de4:
		\L_04d90:
		'玛莉丝，快点——！'
		\L_04e45:
		\L_04e38:
		@L_013dd:
	}
	EC 0:
