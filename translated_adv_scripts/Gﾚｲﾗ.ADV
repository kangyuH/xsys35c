*L_06422:
	IM VAR202, VAR203:
	{RND:
		@L_06422:
	}
	!VAR154 : 6!
	{VAR102 \ 0:
		$L_06504$巴雷斯？$
	}
	$L_06572$玛莉丝？$
	!VAR154 : 7!
	{VAR102 \ 0:
		$L_065bc$利克？$
	}
	!VAR154 : 8!
