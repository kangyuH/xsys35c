*L_007f0:
	!VAR516 : 0!
	%#M.ADV:
	!VAR516 : 1046!
	\L_017ea:
	!VAR516 : 1!
	\L_01742:
	!VAR516 : 425!
	\L_017b2:
	\L_01726:
	ZM 32:
	'利萨斯城' R
	ZM 24:
	R
	'谒见之间'
	\L_01813:
	\L_01806:
	\L_0175e:
	'我来了，利萨斯王。'
	\L_01813:
	\L_01806:
	\L_016ee:
	'………………'
	\L_01813:
	\L_01806:
	\L_0175e:
	'怎么了？' R '看我看入迷了？'
	\L_01813:
	\L_01806:
	\L_016ee:
	'你也是……那个时候，和弗里克' R '他们一起去伊拉普的人' R '吧？'
	\L_01813:
	\L_01806:
	\L_0175e:
	'啊，没错。'
	\L_01813:
	\L_01806:
	\L_016ee:
	'弗里克也是……' R '你也活得好好的啊。'
	\L_01813:
	\L_01806:
	\L_0175e:
	'哈哈哈哈。' R '赫尔曼人的信条就' R '是顽强。'
	\L_01813:
	'不过……利萨斯人看起来也相当' R '顽强啊。'
	\L_01813:
	\L_01806:
	\L_01796:
	'休伯特瞥了兰斯一眼' R '，愉快地这么说道。'
	\L_01813:
	\L_01806:
	\L_016ee:
	'哈哈哈哈。' R '本大爷出身自由都市。' R '所以本大爷很纤细的。'
	\L_01813:
	\L_01806:
	\L_0175e:
	'哦……你不是利萨斯出生的' R '吗？'
	\L_01813:
	\L_01806:
	\L_016ee:
	'那种事无所谓。' R '现在，本大爷是王。'
	\L_01813:
	\L_01806:
	\L_0175e:
	'啊……确实……' R '……呵呵……'
	\L_01813:
	\L_01806:
	\L_016ee:
	'什么？'
	\L_01813:
	\L_01806:
	\L_0175e:
	'巴顿之所以答应和平，' R '我总觉得明白原因了' R '。'
	\L_01813:
	\L_01806:
	\L_016ee:
	'？？'
	\L_01813:
	\L_01806:
	\L_0175e:
	'那么，王先生。' R '我先告辞了。'
	\L_01813:
	'我和巴顿约好了。' R '要陪他修行。'
	\L_01813:
	\L_01806:
	\L_016ee:
	'啊，是吗。' R '你可以走了。'
	\L_01813:
	\L_01806:
	\L_0175e:
	'啊，告辞。'
	\L_01813:
	\L_01806:
	\L_01726:
	'休伯特大步流星地' R '走了出去。'
	\L_01813:
	\L_01806:
	!VAR516 : 0!
	%#M.ADV:
	%0:
*L_00bbc:
	Y 4, 2:
	!VAR690 : RND!
	{VAR690 = 1:
		!VAR516 : 0!
		%#M.ADV:
		!VAR516 : 1046!
		\L_017ea:
		!VAR516 : 1!
		\L_01742:
		!VAR516 : 425!
		\L_017b2:
		\L_01726:
		ZM 32:
		'利萨斯城' R
		ZM 24:
		R
		'谒见之间'
		\L_01813:
		\L_01806:
		\L_0175e:
		'哟。' R '你好吗？' R '利萨斯王。'
		\L_01813:
		\L_01806:
		\L_016ee:
		'嗯……'
		\L_01813:
		\L_01806:
		\L_0175e:
		'怎么了？'
		\L_01813:
		\L_01806:
		\L_016ee:
		'嗯……巴顿虽然也算不上高雅' R '，但总有种……大少爷的气息' R '……可是！'
		\L_01813:
		\L_01806:
		\L_01726:
		'兰斯用手指着休伯' R '特。'
		\L_01813:
		\L_01806:
		\L_016ee:
		'你简直不像是皇子的朋友' R '，太没品了。'
		\L_01813:
		\L_01806:
		\L_0175e:
		'品不品的……'
		\L_01813:
		'我确实是巴顿的朋友' R '……'
		\L_01813:
		'我父亲和帕梅拉皇后' R '关系不好。'
		\L_01813:
		'也是因为这个原因…' R '…从巴顿出生起，' R '我就是巴顿派了。'
		\L_01813:
		'也许因为我们同一年出生' R '，已经是３０年的交情了。'
		\L_01813:
		\L_01806:
		\L_016ee:
		'哦。' R '那么，你父亲是什么人' R '？'
		\L_01813:
		\L_01806:
		\L_0175e:
		'啊？' R '你……不知道我是谁就跟我说话' R '吗？'
		\L_01813:
		'我父亲叫托玛。' R '就是巴顿进攻利萨斯时' R '被你打倒的赫尔曼将军' R '。'
		\L_01813:
		\L_01806:
		\L_016ee:
		'托玛……'
		\L_01813:
		'……托玛……'
		\L_01813:
		'呃！' R '是那个傻大个的' R '儿子吗！！'
		\L_01813:
		\L_01806:
		\L_0175e:
		'没错……'
		\L_01813:
		'那么，是怎样的？' R '我父亲的死法……'
		\L_01813:
		\L_01806:
		\L_016ee:
		'哼，是个不用脑子的家伙。' R '明明带了那么多部下' R '，却冲到最前面，结果成了本大爷的' R '猎物。'
		\L_01813:
		\L_01806:
		\L_0175e:
		'哈哈哈，真像父亲。' R '我放心了。'
		\L_01813:
		'如果是堂堂正正战死的，他一定' R '不会后悔。'
		\L_01813:
		\L_01806:
		\L_016ee:
		'……是啊，他和本大爷战斗' R '的时候，看起来也很开心' R '……'
		\L_01813:
		\L_01806:
		\L_0175e:
		'是吗……看起来很开心吗……' R '不过，对手是你的话，当然' R '会开心。'
		\L_01813:
		\L_01806:
		\L_016ee:
		'什么意思？'
		\L_01813:
		\L_01806:
		\L_0175e:
		'父亲喜欢战斗。' R '尤其是和强者战斗的时候' R '，他总是很开心。'
		\L_01813:
		\L_01806:
		\L_016ee:
		'哼。' R '但是，死了就什么都没了。' R '果然还是笨' R '蛋。'
		\L_01813:
		\L_01806:
		\L_0175e:
		'……是啊……' R '听到他死了的时候……' R '果然还是……'
		\L_01813:
		\L_01806:
		\L_016ee:
		'你恨我吗？'
		\L_01813:
		\L_01806:
		\L_0175e:
		'不……' R '我从小作为军人的孩子长大' R '，一直都有心理准备。'
		\L_01813:
		\L_01806:
		\L_016ee:
		'………………'
		\L_01813:
		'够了。'
		\L_01813:
		\L_01806:
		\L_0175e:
		'好的好的，那我告辞了。'
		\L_01813:
		'……利萨斯王……'
		\L_01813:
		\L_01806:
		\L_016ee:
		'什么？'
		\L_01813:
		\L_01806:
		\L_0175e:
		'你放心。' R '我不会背叛你的。'
		\L_01813:
		\L_01806:
		\L_016ee:
		'哼。'
		\L_01813:
		\L_01806:
		\L_0175e:
		'哈哈哈……'
		\L_01813:
		\L_01806:
		!VAR516 : 0!
		%#M.ADV:
		%0:
	}
	{VAR690 = 2:
		!VAR516 : 0!
		%#M.ADV:
		!VAR516 : 1046!
		\L_017ea:
		!VAR516 : 1!
		\L_01742:
		!VAR516 : 425!
		\L_017b2:
		\L_01726:
		ZM 32:
		'利萨斯城' R
		ZM 24:
		R
		'谒见之间'
		\L_01813:
		\L_01806:
		\L_0175e:
		'你叫我吗？' R '利萨斯王。'
		\L_01813:
		\L_01806:
		\L_016ee:
		'啊，利萨斯的骑士们都在议论' R '，说你的言行举止不像个骑士' R '，觉得很不可思议' R '。'
		\L_01813:
		\L_01806:
		\L_0175e:
		'哦——……' R '没想到还挺受人关注的。'
		\L_01813:
		\L_01806:
		\L_016ee:
		'奇怪的家伙总是很显眼。'
		\L_01813:
		\L_01806:
		\L_0175e:
		'我想，这话对你也适用' R '。'
		\L_01813:
		\L_01806:
		\L_016ee:
		'什么！？'
		\L_01813:
		\L_01806:
		\L_0175e:
		'我希望能像你那样活着' R '。'
		\L_01813:
		'要是让你不高兴可就麻烦了，但' R '不受任何束缚……' R '总之，你看起来很自由' R '。'
		\L_01813:
		\L_01806:
		\L_016ee:
		'哼。算是吧。' R '不过，要是没有本大爷这样的才能，' R '可做不到这样。'
		\L_01813:
		\L_01806:
		\L_0175e:
		'什么忠义啊，豁出性命啊……' R '真是的，没有比骑士更无聊的存在了' R '。'
		\L_01813:
		\L_01806:
		\L_017c0:
		!VAR516 : 6!
		\L_017b2:
		\L_0175e:
		'抱歉打断你们的谈话……'
		\L_01813:
		'休伯特大人。' R '在我看来，对巴顿大人来说，' R '没有比您更值得信赖的骑士了' R '。'
		\L_01813:
		\L_01806:
		\L_017c0:
		!VAR516 : 425!
		\L_017b2:
		\L_0175e:
		'不是因为他是骑士。' R '只是因为我们是好朋友，才在一起的。'
		\L_01813:
		'我不认为那家伙是主君' R '，那家伙也不认为我是忠实的部下' R '什么的' R '。'
		\L_01813:
		\L_01806:
		\L_017c0:
		!VAR516 : 6!
		\L_017b2:
		\L_0175e:
		'我认为友情远远超越主从关系' R '，是非常美好的东西。'
		\L_01813:
		\L_01806:
		\L_017c0:
		!VAR516 : 425!
		\L_017b2:
		\L_0175e:
		'请别说了。' R '这种事，不该说出口的' R '吧？'
		\L_01813:
		\L_01806:
		\L_017c0:
		!VAR516 : 6!
		\L_017b2:
		\L_0175e:
		'呵呵……是啊。'
		\L_01813:
		\L_01806:
		\L_016ee:
		'玛莉丝……你爱上这家伙了吧？'
		\L_01813:
		\L_01806:
		\L_0175e:
		'哎呀，讨厌啦……王真是的……' R '呵呵呵。'
		\L_01813:
		\L_01806:
		\L_017c0:
		!VAR516 : 425!
		\L_017b2:
		\L_0175e:
		'哈哈哈哈哈。' R '被美女爱上，感觉不坏' R '。'
		\L_01813:
		\L_01806:
		\L_016ee:
		'不给。'
		\L_01813:
		\L_01806:
		\L_0175e:
		'好好。'
		\L_01813:
		\L_01806:
		!VAR516 : 0!
		%#M.ADV:
		%0:
	}
