	\L_06727:
	\L_0671a:
	\L_0663a:
	'莉娅出现在王座上' R '翘着腿的兰斯面前。'
	\L_06727:
	\L_0671a:
	\L_06672:
	'……………………'
	\L_06727:
	\L_0671a:
	\L_06602:
	'？'
	\L_06727:
	\L_0671a:
	\L_06672:
	'……………………'
