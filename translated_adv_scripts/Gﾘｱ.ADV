	\L_06727:
	'嘶啦——'
	\L_06727:
	\L_0671a:
	\L_06672:
	'呀啊！' R '礼服……'
	\L_06727:
	\L_0671a:
	\L_0663a:
	'兰斯撕开了莉娅' R '的礼服。'
	\L_06727:
	\L_0671a:
	\L_06602:
	'吵死了。'
	\L_06727:
	\L_0671a:
	\L_06672:
	'啊……！'
	\L_06727:
	\L_0671a:
	\L_0663a:
