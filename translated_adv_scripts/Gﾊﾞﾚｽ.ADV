	\L_011be:
	!VAR516 : 430!
	\L_01116:
	\L_010fa:
	ZM 32:
	'利萨斯城' R
	ZM 24:
	R
	'走廊'
	\L_011e7:
	\L_011da:
	\L_010c2:
	'嗡嗡嗡～。' R '嗡嗡嗡～。'
	\L_011e7:
	'（查卡）' R '喂，飞鸟。' R '不许在走廊上跑。'
	\L_011e7:
	\L_011da:
	\L_010fa:
	'今天飞鸟也精神地在走廊里' R '嗡嗡地跑。'
	\L_011e7:
	\L_011da:
	!VAR516 : 402!
	\L_01186:
	\L_01132:
	'哎呀……'
	\L_011e7:
	\L_011da:
	\L_010c2:
	'哈喵？'
	\L_011e7:
	\L_011da:
	\L_010fa:
	'在走廊尽头，和走着的' R '巴雷斯撞上了。'
	\L_011e7:
	\L_011da:
	\L_01132:
	'这不是查卡大人……' R '还有飞鸟。' R '真精神啊。'
	\L_011e7:
	\L_011da:
	\L_010c2:
	'（咔嚓）' R '哦，巴雷斯大人。' R '真抱歉……'
	\L_011e7:
	\L_011da:
	\L_01132:
	'哈哈哈哈。' R '孩子还是精神点好。' R '对吧？' R '飞鸟。'
	\L_011e7:
	\L_011da:
	\L_010c2:
	'嗯。'
	\L_011e7:
	\L_011da:
	\L_01132:
	'哇哈哈哈。' R '好，这个给你。'
	\L_011e7:
	\L_011da:
	Y 4, 4:
	!VAR690 : RND!
	\L_010fa:
	'飞鸟从巴雷斯那里' R
	{VAR690 = 1:
		'京都海带'
	}
	{VAR690 = 2:
		'巧克力'
	}
	{VAR690 = 3:
		'粉红乌纽恩'
	}
	{VAR690 = 4:
		'哈尼娃娃'
	}
	'得到了' R '。'
	\L_011e7:
	\L_011da:
	\L_010c2:
	'哇——哇——。'
	\L_011e7:
	'（咔嚓）' R '喂，飞鸟。' R '道谢呢？'
	\L_011e7:
	'嗯。' R '谢谢～。' R '爷爷。'
	\L_011e7:
	'（咔嚓）' R '不对，不对。' R '是巴雷斯将军。'
	\L_011e7:
	'巴……巴雷秀。'
	\L_011e7:
	'（咔嚓）' R '将——军。'
	\L_011e7:
	'嗯。' R '巴雷秀将——军。'
	\L_011e7:
	\L_011da:
	\L_01132:
	'哇哈哈哈。' R '不用不用。' R '那再见啦，飞鸟。' R '别受伤啊。'
	\L_011e7:
	\L_011da:
	\L_010c2:
	'嗯。'
	\L_011e7:
	'嗡嗡嗡～。'
	\L_011e7:
	'（查卡）' R '喂，飞鸟！' R '说了不许跑！'
	\L_011e7:
	\L_011da:
	!VAR516 : 0!
