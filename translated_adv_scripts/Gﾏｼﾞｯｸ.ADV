	{VAR690 = 2:
		!VAR516 : 497!
		\L_0b4a5:
		\L_0b419:
		'经常被偷吃。但是，' R '前几天，从城堡寄来了礼金。' R '真的是国王给的吗？' R '（粗点心店店主Ｓ先生）'
		\L_0b506:
		\L_0b4f9:
		\L_0b4b3:
	}
	{VAR690 = 3:
		!VAR516 : 484!
		\L_0b4a5:
		\L_0b419:
		'我的小弟，' R '被当成刀锈了。' R '就算他是坏人……' R '（流氓·Ｍ）'
		\L_0b506:
		\L_0b4f9:
		\L_0b4b3:
