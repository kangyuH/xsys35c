	Y 4, 4:
	!VAR690 : RND!
	{VAR690 = 1:
		!VAR516 : 491!
		\L_0b4a5:
		\L_0b419:
		'前几天被流氓纠缠时，' R '他救了我……' R '但是在那之后……那个……两次……' R '（匿名希望·Ｙ）'
		\L_0b506:
