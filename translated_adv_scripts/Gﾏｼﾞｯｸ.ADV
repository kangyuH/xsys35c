	!VAR516 : 6!
	\L_0b4a5:
	\L_0b419:
	ZM 32:
	'利萨斯城' R
	ZM 24:
	R
	'谒见之间'
	\L_0b506:
	\L_0b4f9:
	\L_0b3e1:
	'玛莉丝……我总觉得' R '全身非常痒……' R '有螨虫或跳蚤吗？'
	\L_0b506:
	\L_0b4f9:
	\L_0b451:
	'啊……' R '不可能有那种事……'
	\L_0b506:
	\L_0b4f9:
