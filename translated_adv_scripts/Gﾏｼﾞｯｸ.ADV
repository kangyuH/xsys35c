	!VAR154 : 37!
	{(VAR690 = 3) * (VAR102 \ 0):
		!VAR516 : 42!
		\L_0b4a5:
		\L_0b419:
		'兰斯王才是勇者。' R '是出现在人类与魔物乱世中的' R '人类之王，救世主。' R '（原赛斯国王·甘地）'
		\L_0b506:
		\L_0b4f9:
		\L_0b4b3:
