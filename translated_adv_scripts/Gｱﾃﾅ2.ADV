*L_0002f:
	SS 2:
	!VAR516 : 0!
	%#M.ADV:
	!VAR516 : 1004!
	\L_01384:
	!VAR516 : 1!
	\L_012dc:
	\L_012c0:
	ZM 32:
	'艾斯镇' R
	ZM 24:
	R
	'兰斯家门口'
	\L_013ad:
	\L_013a0:
	\L_01288:
	'嗯，我家好好地' R '还在啊。'
	\L_013ad:
	'阿特娜那家伙，有好好看家' R '吗？'
	\L_013ad:
	'我回来了——！'
	\L_013ad:
	\L_013a0:
	\L_012c0:
	'兰斯大步走进自己家' R '。'
	\L_013ad:
	{VAR729 = 0:
		@L_00152:
	}
	Y 4, 4:
	{RND = 1:
		@L_00786:
	}
	{RND = 2:
