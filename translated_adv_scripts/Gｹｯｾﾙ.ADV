	MS 10, "凯布里斯军":
	!VAR581 : 1!
	%#FIGT_A.ADV:
	!VAR581 : 0!
	!VAR156 : 133!
	!VAR128 : 1!
	%#死亡捕獲.ADV:
	!VAR516 : 0!
	%#M.ADV:
	!VAR516 : VAR135!
	\L_06132:
	!VAR516 : 1!
	\L_0608a:
	\L_06036:
	'啧……给我记住！！'
	\L_0615b:
	\L_0614e:
	\L_06052:
	'等再拉开点距离之后' R '我还会再来的。'
	\L_0615b:
	\L_0614e:
	\L_06098:
	\L_0606e:
	'兰斯无可奈何地从那里' R '撤退了。'
	\L_0615b:
	\L_0614e:
	!VAR516 : 0!
