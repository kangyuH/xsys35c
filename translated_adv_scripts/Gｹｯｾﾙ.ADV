		!VAR516 : 0!
		%#M.ADV:
		!VAR516 : 10!
		%#M.ADV:
		!VAR516 : VAR135!
		\L_06132:
		!VAR516 : 469!
		\L_060fa:
		\L_060a6:
		'嘿咻……'
		\L_0615b:
		\L_0614e:
		\L_060de:
		'女仆提着装满水的' R '水桶和抹布，来到大厅' R '。'
		\L_0615b:
		\L_0614e:
		\L_060a6:
		'真是的……把这里弄得乱七八糟就' R '走了……不打扫可不行……'
		\L_0615b:
		\L_0614e:
		\L_060de:
		'语气虽然无奈，但' R '脸上却带着几分高兴。'
		\L_0615b:
		\L_0614e:
	}
