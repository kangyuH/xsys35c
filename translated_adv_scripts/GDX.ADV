	}
	{VAR690 = 2:
		\L_027fa:
		\L_02798:
		'古……古拉克！！'
		\L_0284d:
		\L_02840:
		!VAR516 : 263!
		\L_027ec:
		\L_02744:
		'什么？' R '这个男人……'
		\L_0284d:
		\L_02840:
		\L_02798:
		'你……你干的好事！！' R '你明明知道却故意……'
		\L_0284d:
		\L_02840:
		\L_027fa:
		!VAR516 : 443!
		\L_027ec:
		\L_02798:
		'您在说什么呢？'
		\L_0284d:
		\L_02840:
		!VAR516 : 263!
		\L_0277c:
		\L_02728:
		'别装傻！！' R '因为你说让我做，我才' R '我才……'
		\L_0284d:
		'照你说的做，我' R '不是破产了吗！！' R '你打算怎么办！！'
		\L_0284d:
		\L_02840:
		\L_02798:
		'那……' R '就算照我说的做了' R '，也不一定真的能赚钱' R '……'
		\L_0284d:
		'即使那样也没关系，求我告诉你的' R '，是你吧？'
		\L_0284d:
		\L_02840:
		\L_02728:
		'闭嘴！！' R '我破产的钱，通过别的公司' R '流到你那里的事' R '，我已经查过了！！'
		\L_0284d:
		'你……是明知故犯，故意把谎言' R '告诉我的吧！！'
		\L_0284d:
		\L_02840:
		\L_02760:
		'男人向古拉克扑了过去。'
		\L_0284d:
		\L_02840:
		\L_02798:
		'哼……'
		\L_0284d:
		'喝！'
		\L_0284d:
		\L_02840:
		\L_02728:
		'呃啊！！！！'
		\L_0284d:
		\L_02840:
		\L_027d0:
		'古拉克踢出的一脚，深深陷进了男人的躯干' R '。'
		\L_0284d:
		'男人就那样向后飞去，重重地' R '撞在墙上，昏了过去' R '。'
		\L_0284d:
		\L_02840:
		\L_0278a:
		\L_02798:
		'虫子……'
		\L_0284d:
		\L_02840:
		\L_027d0:
		'古拉克打了个响指' R '，他的部下就过来把男人带到某处' R '去了。'
		\L_0284d:
		\L_02840:
		!VAR516 : 1!
		\L_0277c:
		\L_02798:
		'失礼了。' R '让您看到不愉快的东西了' R '。'
		\L_0284d:
		\L_02840:
		\L_02728:
		'什么？' R '刚才的男人。'
		\L_0284d:
		\L_02840:
		\L_02798:
		'谁知道呢……' R '只是个蠢货吧。'
		\L_0284d:
		\L_02840:
	}
	{VAR690 = 3:
		\L_027d0:
		'＜嘟噜噜……＞'
		\L_0284d:
		\L_02840:
		\L_02798:
		'啊……稍等。'
		\L_0284d:
		\L_02840:
		\L_027d0:
		'古拉克说着，从怀里' R '取出了电话。'
		\L_0284d:
		\L_02840:
		\L_02798:
		'是我……现在……'
		\L_0284d:
		'嗯……啊……'
		\L_0284d:
		'……处理掉。' R '就这些。'
		\L_0284d:
		'我现在很忙。' R '该怎么做，' R '你应该清楚吧？' R '……对……就这样。'
		\L_0284d:
		'……不用担心。' R '现在，我们的背后有……'
		\L_0284d:
		'没错。' R '和那时情况不同。' R '但是，要加倍小心。'
		\L_0284d:
		\L_02840:
		\L_027d0:
		'古拉克冷冷地挂断了电话' R '。'
		\L_0284d:
		\L_02840:
		\L_02798:
		'啊，失礼了。'
		\L_0284d:
		\L_02840:
		\L_02728:
		'看来你很忙啊。'
		\L_0284d:
		\L_02840:
		\L_02798:
		'是啊……穷人没有空闲。'
		\L_0284d:
		\L_02840:
		\L_027d0:
		'古拉克只是嘴角笑了笑。'
		\L_0284d:
