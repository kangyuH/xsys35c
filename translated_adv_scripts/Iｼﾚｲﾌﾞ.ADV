		!VAR516 : 1006!
		\L_06935:
		!VAR516 : 423!
		\L_0688d:
		\L_06871:
		ZM 32:
		'赫尔曼国' R
		ZM 24:
		R
		'朗古·巴乌'
		\L_0695e:
		'事实上已成为利萨斯占领地' R '的赫尔曼国，由巴顿' R '实行自治。'
		\L_0695e:
		\L_06951:
		\L_06839:
		'不行啊……' R '兰斯……如果那个国王继续统治下去' R '国家迟早会灭亡。'
		\L_0695e:
		\L_06951:
		!VAR154 : 19!
		{VAR102 \ 0:
			!VAR516 : 424!
			\L_068fd:
			\L_068a9:
			'是啊……' R '他确实是个能干的男人……' R '但胡来的事情太多了。'
			\L_0695e:
			\L_06951:
		}
		{VAR102 = 0:
			\L_06871:
			'巴顿重重地叹了口气' R '。'
			\L_0695e:
			\L_06951:
		}
		\L_06839:
		'照这样下去，不知道什么时候就会爆发大规模内乱' R '。' R '那样的话，赫尔曼独立的日子也会' R '变得遥远。'
		\L_0695e:
		\L_06951:
		!VAR154 : 19!
		{VAR102 \ 0:
			\L_068a9:
			'是啊。' R '为了你的梦想，他好像会' R '成为绊脚石呢……'
			\L_0695e:
			\L_06951:
		}
		{VAR102 = 0:
			!VAR516 : 439!
			\L_068fd:
			\L_068a9:
			'你打算怎么做？'
			\L_0695e:
			\L_06951:
		}
		\L_06839:
		'我……' R '总有一天要和那家伙一决雌雄' R '。'
		\L_0695e:
		'毫不松懈……等待时机……' R '然后，执行赫尔曼独立计划' R '。'
		\L_0695e:
		\L_06951:
		!VAR154 : 19!
		{VAR102 \ 0:
			\L_068a9:
			'那么，必须特训才行呢。'
			\L_0695e:
			\L_06951:
			\L_06839:
			'……啊……是啊……'
			\L_0695e:
			\L_06951:
		}
		{VAR102 = 0:
			\L_068a9:
			'巴顿大人。' R '我们也会努力的。'
			\L_0695e:
			\L_06951:
			\L_06839:
			'嗯……谢谢。'
			\L_0695e:
			\L_06951:
		}
	}
	!VAR154 : 37!
	{VAR102 \ 0:
		!VAR516 : 0!
		%#M.ADV:
		!VAR516 : 1011!
		\L_06935:
		!VAR516 : 42!
		\L_0688d:
		{VAR588 \ 0:
			!VAR516 : 71!
			\L_068fd:
		}
		{(VAR588 = 0) * (VAR587 \ 0):
			!VAR516 : 72!
			\L_068fd:
		}
		\L_06871:
		ZM 32:
		'赛斯宫殿' R
		ZM 24:
		\L_0695e:
		\L_06951:
		\L_06839:
		'………………'
		\L_0695e:
		\L_06951:
		\L_06871:
		'因国王的意愿' R '而成为利萨斯统治地的' R '赛斯宫殿。'
		\L_0695e:
		'甘地坐在宝座上。' R '他默默地抱着胳膊，' R '盯着地板沉思。'
		\L_0695e:
		\L_06951:
		\L_06839:
		'我………' R '错了吗……'
		\L_0695e:
		\L_06951:
		{(VAR588 \ 0) + (VAR587 \ 0):
			\L_068a9:
			'甘地大人……'
			\L_0695e:
			\L_06951:
		}
		\L_06855:
		'兰斯王……在那个男人的手下，' R '世界确实统一了。' R '但这真的是' R '预言中的统一世界吗……'
		\L_0695e:
		'确实，地图上的国境消失了。' R '但是，人心却混乱不堪。' R '隔阂依然存在……'
		\L_0695e:
		'这样下去，人类会再次分裂，' R '世界将陷入战乱。' R '魔物们可能会趁机' R '卷土重来。'
		\L_0695e:
		\L_06951:
		\L_06871:
		'甘地的眼中' R '闪耀着意志的力量。'
		\L_0695e:
		\L_06951:
		\L_06839:
		'兰斯王……' R '那个让我着迷、甘愿侍奉的男人。' R '那时他确实是英雄。' R '在乱世中大显身手。'
		\L_0695e:
		'但在和平之中，' R '他的力量似乎无处施展……' R '战时的王，终究无法成为' R '和平时期的王吗。'
		\L_0695e:
		'也就是说……' R '他并非真正的救世主。'
		\L_0695e:
		{(VAR588 \ 0) + (VAR587 \ 0):
			\L_06951:
			\L_068a9:
			'…………！'
			\L_0695e:
			\L_06951:
			\L_06839:
		}
		'好不容易统一的人类国家，' R '不能让它毁灭。' R '那个男人……我名义上的主君，' R '必须请他退位……'
		\L_0695e:
		\L_06951:
		{(VAR588 \ 0) + (VAR587 \ 0):
			{VAR587 \ 0:
				\L_0690b:
				!VAR516 : 72!
				\L_068fd:
			}
			\L_068a9:
			'终于……' R '您终于醒悟了，' R '甘地大人……！'
			\L_0695e:
			{(VAR588 \ 0) * (VAR587 \ 0):
				\L_06951:
				\L_0690b:
				!VAR516 : 71!
				\L_068fd:
				\L_068a9:
			}
			'我们一直等待着' R '您的这句话。'
			\L_0695e:
			\L_06951:
			\L_06871:
			{VAR588 \ 0:
				'威奇托'
			}
			{(VAR588 = 0) * (VAR587 \ 0):
				'薰'
			}
			'递出了一把剑' R '。' R
		}
		{(VAR588 = 0) * (VAR587 = 0):
			\L_06871:
		}
		'甘地拿起赛斯王室相传的' R '剑，站了起来。'
		\L_0695e:
		\L_06951:
		\L_06839:
		'原谅我，兰斯王……！' R '一切都是为了正义。'
		\L_0695e:
		\L_06951:
		!VAR154 : 39!
		{VAR102 \ 0:
			{(VAR588 \ 0) + (VAR587 \ 0):
				\L_0690b:
			}
			!VAR516 : 58!
			\L_068fd:
			\L_068a9:
			'笨蛋老爸……现在才醒悟，太迟了。'
			\L_0695e:
			\L_06951:
			\L_06839:
			'玛吉柯。'
			\L_0695e:
			\L_06951:
			\L_06871:
			'甘地正要走出大厅，' R '玛吉柯挡在了他面前。' R '玛吉柯一拳捶在父王厚实的胸膛上' R '。'
			\L_0695e:
			\L_06951:
			\L_068a9:
			'我也去……' R '你是要去给那个男人送终吧。'
			\L_0695e:
			\L_06951:
			\L_06839:
			'嗯，走吧，玛吉柯。'
			\L_0695e:
			\L_06951:
			\L_06871:
			'两人离开了王座……'
			\L_0695e:
			\L_06951:
		}
	}
