	\L_09d35:
	\L_09d19:
	ZM 32:
	'赛斯国' R
	ZM 24:
	R
	'千鹤子之塔　司令室'
	\L_09e06:
	\L_09df9:
	{(VAR650 = 8) + (VAR650 = 9):
		\L_09ce1:
		'啊……' R '啊～啊啊啊啊啊……'
		\L_09e06:
		\L_09df9:
		!VAR516 : 478!
		\L_09da5:
		\L_09d51:
		'千鹤子大人……千鹤子大人！'
		\L_09e06:
		\L_09df9:
		\L_09ce1:
		'啊？' R '是，是，啊…'
		\L_09e06:
		\L_09df9:
		\L_09d51:
		'请振作一点…' R '我想得到出击的许可。'
		\L_09e06:
		\L_09df9:
		\L_09ce1:
		'啊……出击？' R '……好的，请……' R '随便去吧。'
		\L_09e06:
		'如果见到甘地大人的话……' R '呜，如果见到甘地大人的话' R '……呜呜……'
		\L_09e06:
		'请代我……向他问好……' R '呜呜呜……'
		\L_09e06:
		\L_09df9:
		\L_09d51:
		'是……明白了。' R '那么，我出击了。'
		\L_09e06:
		\L_09df9:
		\L_09d19:
		'一脸为难地，' R '部下离开了司令室。'
		\L_09e06:
		\L_09df9:
		\L_09db3:
		\L_09ce1:
		'呜呜……甘地大人啊……'
		\L_09e06:
		\L_09df9:
		!VAR516 : 0!
		%#M.ADV:
		%0:
	}
	{VAR336 = 6:
