		\L_09e06:
		\L_09df9:
	}
	\L_09ce1:
	'是啊……对不起。'
	\L_09e06:
	\L_09df9:
	{VAR336 = 6:
		\L_09d43:
		!VAR516 : 478!
		\L_09d35:
		\L_09ce1:
