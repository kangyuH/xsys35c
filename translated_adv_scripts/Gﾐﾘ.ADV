	\L_05b59:
	\L_05b05:
	'…呜……'
	\L_05bba:
	\L_05bad:
	\L_05a95:
	'哦？'
	\L_05bba:
	\L_05bad:
	\L_05b05:
	'嗯……'
	\L_05bba:
	\L_05bad:
	\L_05a95:
	'醒了吗。' R '米莉。'
	\L_05bba:
	\L_05bad:
	\L_05b05:
	'……诶…'
	\L_05bba:
	'……兰斯…？'
	\L_05bba:
