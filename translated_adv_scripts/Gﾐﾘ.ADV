	\L_05bba:
	\L_05bad:
	\L_05b05:
	'原来是这样啊…' R '谢谢你。' R '小妹妹。'
	\L_05bba:
	\L_05bad:
	\L_05b67:
	!VAR516 : 70!
	\L_05b59:
	\L_05b05:
