	\L_05bba:
	\L_05bad:
	\L_05b67:
	!VAR516 : 67!
	\L_05b59:
	\L_05b05:
	'诶…这么个小女孩…？'
	\L_05bba:
	\L_05bad:
	\L_05a95:
