	\L_0b3f3:
	ZM 32:
	'赛斯国' R
	ZM 24:
	R
	'芭芭雅之塔　顶层'
	\L_0b4e0:
	'在装饰风格恶魔般的研究室里，' R '帕帕雅正在做实验。'
	\L_0b4e0:
	Y 4, 2:
	!VAR690 : RND!
	{VAR690 = 1:
		'＜喵喵喵＞'
		\L_0b4e0:
		'＜喵喵喵喵＞'
		\L_0b4e0:
		\L_0b4d3:
		\L_0b3bb:
		'嗯……？'
		\L_0b4e0:
		\L_0b4d3:
		\L_0b3f3:
		'帕帕雅停下实验，' R '抬头看向警报装置（牛头）' R '。'
		\L_0b4e0:
		\L_0b4d3:
		\L_0b3bb:
		'哎呀，有客人？' R '是利萨斯军吗……' R '喂，诺米孔，你觉得呢？'
		\L_0b4e0:
		'（诺米孔）' R '呼噜呼噜……' R '眼睛痒就用长柄斧。' R '嘿嘿嘿嘿……'
		\L_0b4e0:
		'真是的，居然在睡觉……' R '喂喂，大哥哥你怎么想？' R '你觉得是你的同伴来了吗？'
		\L_0b4e0:
		\L_0b4d3:
		\L_0b3f3:
		'帕帕雅对' R '着眼前不知从哪' R '里抓来的利萨斯兵，' R '可爱地歪了歪头。'
		\L_0b4e0:
		\L_0b4d3:
		!VAR516 : 471!
		\L_0b47f:
		\L_0b42b:
		'呜……啊嘿嚯…………'
		\L_0b4e0:
		\L_0b4d3:
		\L_0b3f3:
		'男人发出了奇妙、' R '不成声的声音。' R '他的右半身像人体模型一样' R '皮肤被剥掉了。'
		\L_0b4e0:
		\L_0b4d3:
		\L_0b48d:
		\L_0b3bb:
		'真是的，那样的话' R '可不行啊。' R '作为新型警报装置，' R '你可不称职哦？'
		\L_0b4e0:
		'看来暂时还是' R '得靠小牛啊……' R '对吧，小牛。'
		\L_0b4e0:
		\L_0b4d3:
		\L_0b3f3:
		'＜喵喵喵喵＞'
		\L_0b4e0:
		\L_0b4d3:
		\L_0b3bb:
		'啊，对了，' R '敌人来了。' R '那再见啦，大哥哥。' R '喂，快起来，诺米孔，我们走。'
		\L_0b4e0:
		'（诺米孔）' R '呼噜呼噜……' R '蓝色橡胶草鞋——辉彦——。' R '嘿嘿嘿嘿……'
		\L_0b4e0:
		\L_0b4d3:
		\L_0b3f3:
		'芭芭雅拿起诺米孔，' R '走出了房间……'
		\L_0b4e0:
	}
	{VAR690 \ 1:
		'突然……' R '诺米孔开始吵闹起来。'
		\L_0b4e0:
		\L_0b4d3:
		\L_0b3bb:
		'（诺米孔）' R '嘿嘿嘿嘿嘿嘿……！' R '大姐，有客人——！' R '来了个爱吃柿子的客人——！'
		\L_0b4e0:
		\L_0b4d3:
		\L_0b3f3:
		'芭芭雅停下实验，' R '回头看向诺米孔。'
		\L_0b4e0:
		\L_0b4d3:
		\L_0b3bb:
		'诶——，有客人——？' R '真麻烦。' R '诺米孔，你去应付吧……'
		\L_0b4e0:
		'（诺米孔）' R '那我去去就回。' R '把我送到客人那里去。' R '嘿嘿嘿嘿嘿……'
		\L_0b4e0:
		'真是的……结果' R '还不是得我去。' R '明明正做着开心的实验呢。'
		\L_0b4e0:
		'切，这个脑髓活性化装置，' R '没时间戴上了……' R '会坏死的。'
		\L_0b4e0:
		\L_0b4d3:
		\L_0b3f3:
		'帕帕雅面前，' R '散落的人体' R '滚落一地。'
		\L_0b4e0:
		\L_0b4d3:
		\L_0b3bb:
		'真可惜，这个可爱的脑髓，' R '本来可以' R '变成天才的。'
		\L_0b4e0:
		'要恨的话，' R '别恨解剖你的我，' R '去恨那些客人吧。' R '大哥哥。'
		\L_0b4e0:
		\L_0b4d3:
		\L_0b3f3:
		'＜啾＞'
		\L_0b4e0:
		'帕帕雅亲吻了堆积如山的零件中的' R '脑髓和脊椎，' R '然后走出了房间。'
		\L_0b4e0:
		\L_0b4d3:
		\L_0b3bb:
		'喂喂，诺米孔，' R '客人是利萨斯军吗？'
		\L_0b4e0:
		'（诺米孔）' R '哦，快乐的利萨斯，' R '愉快的利萨斯，利萨斯，' R '利——萨——斯。嘿嘿嘿嘿嘿……'
		\L_0b4e0:
	}
	\L_0b4d3:
