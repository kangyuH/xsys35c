*L_00975:
	{VAR353 = 4:
		\L_03516:
		'Ｈ的事情……'
		\L_0363b:
		'要等你成为天使之后。'
		\L_0363b:
		\L_0362e:
		\L_03586:
		'是。'
		\L_0363b:
		\L_0362e:
		\L_03516:
		'别忘了。'
		\L_0363b:
		\L_0362e:
		\L_03586:
		'当然。' R '天使不会说谎。' R '呵呵。'
		\L_0363b:
		\L_0362e:
		\L_03516:
		'嗯嗯……'
		\L_0363b:
		\L_0362e:
		\L_03586:
		'那么…国王。' R '您有什么事？'
		\L_0363b:
		\L_0362e:
		\L_03516:
		'啊～……'
		\L_0363b:
		'帮我揉揉肩膀。'
		\L_0363b:
		\L_0362e:
		\L_03586:
		'好的，我知道了。' R '我很擅长。' R '一个小时左右，完全没问题' R '。'
		\L_0363b:
		'那么，失礼了。'
		\L_0363b:
		\L_0362e:
		\L_03516:
		'嗯……'
		\L_0363b:
		'哦……'
		\L_0363b:
		'哦哦…'
		\L_0363b:
		'哦～……'
		\L_0363b:
		\L_0362e:
		\L_03586:
		'呵呵…兰斯王真是的…'
		\L_0363b:
		\L_0362e:
		\L_0354e:
		'兰斯在娅米塔的按摩中' R '度过了至福的时光。'
