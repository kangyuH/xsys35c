*L_00a1a:
	Y 4, 3:
	!VAR690 : RND!
	{VAR690 = 1:
		\L_096f4:
		!VAR516 : 96!
		\L_096e6:
		\L_09692:
		'帕帕。'
		\L_09747:
		\L_0973a:
		\L_09622:
		'嗯？' R '怎么了，莉赛特。'
		\L_09747:
		\L_0973a:
		\L_09692:
		'呵呵～…' R '没什么…'
		\L_09747:
		\L_0973a:
		\L_096ca:
		'莉赛特露出孩子特有的傻笑' R '，向兰斯投去' R '。'
		\L_09747:
		\L_0973a:
		\L_09692:
		'呼呼…' R '哇…' R '帕帕，帕帕…' R '啊哈哈…'
		\L_09747:
		\L_0973a:
		\L_0965a:
		'然后，绕着兰斯转' R '了起来。'
		\L_09747:
		\L_0973a:
		\L_096f4:
		!VAR516 : 493!
		\L_096e6:
		\L_09692:
		'这，莉赛特…' R '老实点…'
		\L_09747:
		\L_0973a:
		\L_09622:
		'啊，没关系。' R '孩子还是精神点好。' R '不过……怎么说呢…'
		\L_09747:
		\L_0973a:
		\L_09692:
		'什么？'
		\L_09747:
		\L_0973a:
		\L_09622:
		'因为是自己的孩子所以可爱…' R '要不是自己的孩子，早就绊倒' R '他弄哭取乐了。'
		\L_09747:
		\L_0973a:
		\L_09692:
		'兰斯…'
		\L_09747:
		\L_0973a:
		\L_09622:
		'啊，没事。' R '我不会对莉赛特做那种事。' R '她哭了才麻烦。'
		\L_09747:
		\L_0973a:
		\L_09692:
		'……呵呵…'
		\L_09747:
		\L_0973a:
		\L_096f4:
		!VAR516 : 96!
		\L_096e6:
		\L_09692:
		'帕帕，你要待到什么时候？' R '陪莉赛特睡觉' R '吗？' R '洗澡呢？？'
		\L_09747:
		\L_0973a:
		\L_09622:
		'抱歉，莉赛特。' R '我要回去了。'
		\L_09747:
		\L_0973a:
		\L_09692:
		'……这样啊？'
		\L_09747:
		\L_0973a:
		\L_09622:
		'嗯。'
		\L_09747:
		\L_0973a:
		\L_09692:
		'那，莉赛特也要和帕帕' R '一起回去。' R '回去，回去～…'
		\L_09747:
		\L_0973a:
		\L_096ca:
		'莉赛特抓住兰斯的斗篷' R '，轻轻地拉了拉。'
		\L_09747:
		\L_0973a:
		\L_096f4:
		!VAR516 : 493!
		\L_096e6:
		\L_09692:
		'莉赛特…不能给爸爸添麻烦' R '哦…'
		\L_09747:
		\L_0973a:
		\L_096f4:
		!VAR516 : 96!
		\L_096e6:
		\L_09692:
		'呀～～…' R '帕帕…'
		\L_09747:
		\L_0973a:
		\L_096ca:
		'莉赛特踮起脚，使劲拽着兰斯' R '。'
		\L_09747:
		\L_0973a:
		\L_09622:
		'喂，帕斯特尔…' R '就一会儿…'
		\L_09747:
		\L_0973a:
		\L_096f4:
		!VAR516 : 493!
		\L_096e6:
		\L_09692:
		'那怎么行…' R '这孩子是卡拉的下任女王…' R '而且她还太小，不能到外面去' R '…'
		\L_09747:
		\L_0973a:
		\L_09622:
		'这样啊…那就没办法了。' R '莉赛特。'
		\L_09747:
		\L_0973a:
		\L_096f4:
		!VAR516 : 96!
		\L_096e6:
		\L_09692:
		'嗯…'
		\L_09747:
		\L_0973a:
		\L_09622:
		'爸爸会时不时来看你的…' R '要听妈妈的话。'
		\L_09747:
		\L_0973a:
		\L_09692:
		'唔～～…'
		\L_09747:
		\L_0973a:
		\L_09622:
		'下次来的时候，陪你一起玩' R '。'
		\L_09747:
		\L_0973a:
		\L_09692:
		'……唔……'
		\L_09747:
		\L_0973a:
		\L_0965a:
		'莉赛特点了点头。'
		\L_09747:
		\L_0973a:
		\L_09622:
		'好，真乖。' R '那再见。'
		\L_09747:
		\L_0973a:
		\L_09692:
		'……嗯……'
		\L_09747:
		\L_0973a:
		\L_0965a:
		'兰斯离开了卡拉村。'
		\L_09747:
		\L_0973a:
	}
	{VAR690 = 2:
		\L_096f4:
		!VAR516 : 96!
		\L_096e6:
		\L_09692:
		'帕帕，帕帕…' R '这个…给你…'
		\L_09747:
		\L_0973a:
		\L_09622:
		'嗯？' R '你要给我什么，莉赛特。'
		\L_09747:
		\L_0973a:
		\L_096ca:
		'莉赛特踮起脚，用双手' R '把纸递给了兰斯。'
		\L_09747:
		\L_0973a:
		\L_09622:
		'什么啊…'
		\L_09747:
		\L_0973a:
		\L_0965a:
		'兰斯把它摊开了。'
		\L_09747:
		'纸的中央画着一个穿着以绿色为主体的衣服' R '的人，还有像是森林' R '的密集绿色，以及长' R '头发的人形物体。'
		\L_09747:
		'画在上面。'
		\L_09747:
		\L_0973a:
		\L_09622:
		'这是…？'
		\L_09747:
		\L_0973a:
		\L_09692:
		'帕帕和，莉赛特和…' R '我们的家。'
		\L_09747:
		\L_0973a:
		\L_09622:
		'原来如此。' R '这个中间像人一样的物体' R '是我吗。'
		\L_09747:
		\L_0973a:
		\L_09692:
		'嗯！'
		\L_09747:
		\L_0973a:
		\L_0965a:
		'莉赛特笑着' R '点了点头。'
		\L_09747:
		\L_0973a:
		\L_09622:
		'那么，这个就是莉赛特吗。'
		\L_09747:
		\L_0973a:
		\L_09692:
		'嗯！'
		\L_09747:
		\L_0973a:
		\L_09622:
		'绿色的海胆是指卡拉森林' R '吗…'
		\L_09747:
		\L_0973a:
		\L_09692:
		'嗯。'
		\L_09747:
		\L_0973a:
		\L_09622:
		'画得很好哦，莉赛特。'
		\L_09747:
		\L_0973a:
		\L_09692:
		'嘿嘿～……'
		\L_09747:
		\L_0973a:
		\L_096f4:
		\L_096ca:
		'莉赛特脸变得通红，躲到了帕斯' R '的背后。'
		\L_09747:
		\L_0973a:
		!VAR516 : 493!
		\L_096e6:
		\L_09692:
		'呵呵…这孩子，总是吵着帕帕什么时候' R '来，真的很' R '喜欢兰斯呢。'
		\L_09747:
		\L_0973a:
		\L_09622:
		'……感觉不坏…'
		\L_09747:
		\L_0973a:
		\L_09692:
		'兰斯。' R '今天要不要留下来吃顿饭' R '呢？'
		\L_09747:
		\L_0973a:
		\L_09622:
		'是啊…' R '好，今天就住下来' R '吧。'
		\L_09747:
		\L_0973a:
		\L_096f4:
		!VAR516 : 96!
		\L_096e6:
		\L_09692:
		'真的吗？'
		\L_09747:
		\L_0973a:
		\L_09622:
		'啊。'
		\L_09747:
		\L_0973a:
		\L_09692:
		'那么，莉赛特，和帕帕和妈' R '妈一起…洗澡，洗澡…要一起' R '洗澡…'
		\L_09747:
		\L_0973a:
		\L_09622:
		'啊，没关系。'
		\L_09747:
		\L_0973a:
		\L_09692:
		'还有呢…' R '莉赛特…想和帕帕一起睡' R '觉…'
		\L_09747:
		\L_0973a:
		\L_09622:
		'好，一起睡吧。'
		\L_09747:
		\L_0973a:
		\L_09692:
		'嘿嘿～…' R '哇——，哇——！'
		\L_09747:
		\L_0973a:
		\L_0963e:
		'……哇……还不错啊…' R '这样的气氛也……'
		\L_09747:
		\L_0973a:
		\L_0965a:
		'就这样，兰斯忘记了平日的繁重工作' R '在卡拉森林和女儿一起，度过了一段时光' R '。'
		\L_09747:
		R
		'………'
		\L_09747:
		R
		'……'
		\L_09747:
		R
		'…'
		\L_09747:
		\L_0973a:
	}
	{VAR690 = 3:
		\L_096f4:
		!VAR516 : 96!
		\L_096e6:
		\L_09692:
		'帕帕。'
		\L_09747:
		\L_0973a:
		\L_09622:
		'哦，怎么了？'
		\L_09747:
		\L_0973a:
		\L_09692:
		'莉赛特，做了薄煎饼' R '哦。'
		\L_09747:
		\L_0973a:
		\L_09622:
		'哦……已经会做那种东西了吗' R '。真厉害啊，莉赛特。'
		\L_09747:
		\L_0973a:
		\L_09692:
		'嘿嘿～…' R '然后呢，然后呢，我想给帕帕吃' R '，就留下来了' R '。'
		\L_09747:
		\L_0973a:
		\L_09622:
		'哦……那真是期待啊。' R '要给我吃吗？'
		\L_09747:
