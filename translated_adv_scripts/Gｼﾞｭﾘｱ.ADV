	\L_043ed:
	\L_043d1:
	ZM 32:
	'利萨斯城' R
	ZM 24:
	R
	'莉娅的房间前'
	\L_044be:
	\L_044b1:
	\L_04399:
	'莉娅～。' R '来玩吧～。'
	\L_044be:
	\L_044b1:
	\L_043d1:
	'门开了，莉娅探出头来。'
	\L_044be:
	\L_044b1:
	!VAR516 : 5!
	\L_0445d:
	Y 4, 2:
	!VAR690 : RND!
	{VAR690 = 1:
		\L_04409:
		'嗯，茱莉亚。'
		\L_044be:
		\L_044b1:
		\L_04399:
		'那个，我们去河里抓鱼吧' R '。' R '河水凉凉的，很舒服' R '哦。'
		\L_044be:
		\L_044b1:
		\L_04409:
		'嗯，走吧。'
		\L_044be:
		\L_044b1:
		\L_04399:
		'喵哈哈…' R '快点，快点。'
		\L_044be:
		\L_044b1:
		\L_04409:
		'啊，等等我，茱莉亚…'
		\L_044be:
		\L_044b1:
		\L_043d1:
		'两人亲密地出门去河里抓鱼了' R '。'
		\L_044be:
		\L_044b1:
	}
	{VAR690 = 2:
		\L_04409:
		'对不起…' R '现在钢琴老师来了，' R '所以不行…'
		\L_044be:
		\L_044b1:
		\L_04399:
		'这样啊……真遗憾……'
		\L_044be:
		\L_044b1:
		\L_04409:
		'下次再约我哦。'
		\L_044be:
		\L_044b1:
		\L_04399:
		'嗯……'
		\L_044be:
		\L_044b1:
		\L_043d1:
		'茱莉亚无精打采地' R '回自己房间去了。'
		\L_044be:
		\L_044b1:
	}
