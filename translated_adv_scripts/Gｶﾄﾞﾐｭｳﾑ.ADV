	\L_03186:
	\L_030fa:
	ZM 32:
	'利萨斯城' R
	ZM 24:
	R
	'谒见之间'
	\L_031e7:
	\L_031da:
	\L_03132:
	'嗡嗡嗡～。' R '兰斯～。'
	\L_031e7:
	\L_031da:
	\L_030c2:
	'国王陛下。'
	\L_031e7:
	\L_031da:
	\L_03132:
	'国王～。'
	\L_031e7:
	\L_031da:
	\L_030c2:
	'嗯，好。'
	\L_031e7:
	\L_031da:
	\L_03132:
	'飞鸟，肚子饿了吧～。'
	\L_031e7:
	\L_031da:
	\L_030c2:
	'玛莉丝！'
	\L_031e7:
	\L_031da:
	\L_03194:
	!VAR516 : 6!
	\L_03186:
	\L_03132:
	'好的，飞鸟。' R '给你巧克力吧。'
	\L_031e7:
	\L_031da:
	\L_03194:
	!VAR516 : 430!
	\L_03186:
	\L_03132:
	'好～。' R '谢谢～玛莉丝。'
	\L_031e7:
	'（查卡）' R '总是麻烦你了。'
	\L_031e7:
	\L_031da:
	\L_030c2:
	'那么，怎么样？' R '状态如何。'
	\L_031e7:
	\L_031da:
	\L_03132:
	'咦？？'
	\L_031e7:
	\L_031da:
	\L_030c2:
	'啊，是问老爷子。'
	\L_031e7:
	\L_031da:
	\L_03132:
	'（查卡）' R '还是老样子。'
	\L_031e7:
	\L_031da:
	\L_030c2:
	'嗯，是吗。'
	\L_031e7:
	\L_031da:
	\L_03132:
	'还是老样子～。' R '国王，要吃巧克力吗？'
	\L_031e7:
	\L_031da:
	\L_030c2:
	'哦，谢啦。' R '嚼嚼……'
	\L_031e7:
	\L_031da:
	\L_03132:
	'好吃吧？'
	\L_031e7:
	\L_031da:
	\L_030c2:
	'嗯，好吃，好吃。'
	\L_031e7:
	\L_031da:
	\L_030de:
	'……唔～嗯……' R '有孩子在，该怎么说呢……' R '紧张感都没了……'
	\L_031e7:
	\L_031da:
	\L_030c2:
	'够了。' R '退下。'
	\L_031e7:
	\L_031da:
	\L_03132:
	'退下～。' R '多谢款待。'
	\L_031e7:
	'（查卡）' R '那么，告辞……'
	\L_031e7:
	'嗡嗡～。' R '嗡嗡～。'
	\L_031e7:
	'（查卡）' R '啊，飞鸟。' R '不能跑，不能跑。'
	\L_031e7:
