	\L_031e7:
	\L_031da:
	\L_030c2:
	'（查卡）' R '喂，飞鸟。' R '去哪里？' R '那边不是房间哦。'
	\L_031e7:
	'嗡嗡～。' R '嗡嗡～。'
	\L_031e7:
	\L_031da:
	\L_030fa:
