*L_00b5d:
	Y 4, 3:
	!VAR690 : RND!
	{VAR690 = 1:
		!VAR516 : 0!
		%#M.ADV:
		!VAR516 : 1046!
		\L_08df8:
		!VAR516 : 1!
		\L_08d50:
		!VAR516 : 423!
		\L_08dc0:
		\L_08d34:
		ZM 32:
		'利萨斯城' R
		ZM 24:
		R
		'谒见之间'
		\L_08e21:
		'被兰斯叫来的巴顿，站在玉' R '座前。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'哦，来了啊，来了啊。' R '给。' R '你也吃吧。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'这是什么……'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'豆沙包。' R '很好吃哦。' R '本大爷现在心情好，所以分你' R '一个。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'啊，谢了……'
		\L_08e21:
		'话说回来……' R '你叫我来，是有事吧' R '？'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'哦，没错。'
		\L_08e21:
		'你虽然是庶出，但也是王子' R '吧？'
		\L_08e21:
		'所以我想，关于赫尔曼的战力' R '，你是不是知道些什么' R '。'
		\L_08e21:
		'你觉得他们的战力如何？'
		\L_08e21:
		\L_08e14:
		\L_08d88:
		'这可不是边吃豆沙包边谈的内容' R '啊……算了，无所谓。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'啊……是啊……'
		\L_08e21:
		'确实，现在的赫尔曼已经腐败透顶' R '，实力恐怕只有几年前的一半' R '。'
		\L_08e21:
		'但若只论兵力和数量，仍然' R '超过利萨斯。' R '我认为应该全力应对。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'嗯……'
		\L_08e21:
		'那么，如果你没能成为本大爷的部下' R '，你打算怎么' R '夺回赫尔曼' R '？'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'………………'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'……唔唔……'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'……我没想过……'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'哈哈哈哈！' R '就凭那么点兵力，你打算不做任何计划' R '直接突击吗？'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'……那就是我的做法……'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'……真是个难以置信的家伙……' R '就算是本大爷，也不会那么乱来' R '。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'……啊，汉蒂和弗里克也' R '总是这么说我。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'看来得好好想想怎么用你' R '才行。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'…………'
		\L_08e21:
		'也许吧……'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'算了。' R '我明白了。' R '退下吧。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'啊。'
		\L_08e21:
		\L_08e14:
		\L_08da4:
		'巴顿从玉座前' R '离开了。'
		\L_08e21:
		\L_08e14:
		!VAR516 : 0!
		%#M.ADV:
		%0:
	}
	{VAR690 = 2:
		!VAR516 : 0!
		%#M.ADV:
		!VAR516 : 1046!
		\L_08df8:
		!VAR516 : 1!
		\L_08d50:
		\L_08d34:
		ZM 32:
		'利萨斯城' R
		ZM 24:
		R
		'谒见之间'
		\L_08e21:
		'兰斯在等巴顿。'
		\L_08e21:
		\L_08e14:
		!VAR516 : 423!
		\L_08dc0:
		\L_08d6c:
		'我迟到了。' R '抱歉。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'你干什么去了？'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'不……我在修行，在树荫下' R '休息的时候睡着了' R '。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'今天还有点冷，你居然在树荫下午' R '睡……赫尔曼人真结实啊。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'哈哈哈……' R '这种气温，在赫尔曼' R '已经算热了。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'闲话休提。' R '我想问你一件事。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'什么？'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'攻打自己的国家，是' R '什么心情？'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'……如果说毫无感觉，那是骗人' R '，但现在的赫尔曼，已经不是我所' R '认识的赫尔曼了' R '。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'这借口不错。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'……不这么想的话，就撑不' R '下去了……'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'如果你不愿意，我也不是不能考虑' R '别的用法。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'不必费心。' R '我不能逃避眼前的考验' R '。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'哦，说得挺好。' R '那就让你去赫尔曼' R '攻略的最前线吧。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'啊，随时吩咐。' R '我心理准备万全。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'我只是想听你这么说。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'是吗……' R '那我继续去修行' R '了。' R '有事再叫我。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'哦，改天吧。'
		\L_08e21:
		\L_08e14:
		!VAR516 : 0!
		%#M.ADV:
		%0:
	}
	{VAR690 = 3:
		!VAR516 : 0!
		%#M.ADV:
		!VAR516 : 1046!
		\L_08df8:
		!VAR516 : 1!
		\L_08d50:
		!VAR516 : 423!
		\L_08dc0:
		\L_08d34:
		ZM 32:
		'利萨斯城' R
		ZM 24:
		R
		'谒见之间'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'你叫我吗？' R '利萨斯王。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'哦。' R '来，过来，过来。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'什么事？'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'你当了赫尔曼皇帝之后' R '打算怎么做？' R '想把国家整合起来，脱离本大爷的支配' R '吗？'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'……我从来没想过要和你对抗' R '。' R '只是回到这场战争前的状态而' R '已。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'我可没打算照顾赫' R '尔曼。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'……我在考虑贸易。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'贸易？'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'……赫尔曼有矿产资源。' R '我想和利萨斯丰富的食物进行交换' R '贸易。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'原来如此……'
		\L_08e21:
		'那么，我们这边出１０吨食物，' R '你那边用１０吨铁和' R '１０吨黄金来交换之类的……'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'那太离谱了。' R '要是那么做，我们马上' R '就会变得更穷。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'那么，１０吨食物，换１００个可爱的' R '女孩子，再加５吨黄金' R '也行啊。哈哈哈哈。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'那是……'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'那么……'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'够了，算了！！' R '那个，到时候再考虑！' R '在那之前，你的无理要求' R '能不能接受，我会给你答复！'
		\L_08e21:
		\L_08e14:
		\L_08dce:
		\L_08da4:
		'巴顿气呼呼地' R '离开了宝座前。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'和外表不同，是个开不起玩笑的' R '家伙啊……'
		\L_08e21:
		\L_08e14:
		!VAR516 : 6!
		\L_08dc0:
		\L_08d6c:
		'刚才的……' R '是开玩笑吗？'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'玛莉丝，连你都……'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'因为和平时向各处提出的' R '要求没什么两样，' R '所以我也以为您是认真的' R '呢。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'真没礼貌。' R '我可是更绅士的。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'啊，好忙……'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'………唔……'
		\L_08e21:
		\L_08e14:
		!VAR516 : 0!
		%#M.ADV:
		%0:
	}
*L_0190d:
	Y 4, 4:
	!VAR690 : RND!
	{VAR690 = 1:
		!VAR516 : 0!
		%#M.ADV:
		!VAR516 : 1046!
		\L_08df8:
		!VAR516 : 1!
		\L_08d50:
		!VAR516 : 423!
		\L_08dc0:
		\L_08d34:
		ZM 32:
		'利萨斯城' R
		ZM 24:
		R
		'谒见之间'
		\L_08e21:
		'巴顿站在兰斯面前。' R '巴顿的脖子上挂着一条可爱的' R '毛巾。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'………………'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'怎么了？'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'我在想，你拿着一条和脸不搭的' R '毛巾呢。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'啊……这个啊。' R '修行之后洗了脸，正愁没有毛巾' R '的时候，一个女仆模样的' R '姑娘借给我的。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'…………不给你。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'啊……毛巾吗？' R '我打算洗了再还。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'不，不是那个……'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'……？'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'算了。' R '我知道你对这种事很迟钝' R '了……'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'什么啊，那种说法……'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'哎呀，吵死了。' R '我是有事才叫你来的。'
		\L_08e21:
		'怎么样，当上皇帝的心情如何？'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'啊……'
		\L_08e21:
		'没什么特别的变化。' R '难事都由汉蒂和弗里克' R '两个人处理了。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'你好好告诉那两个人。' R '统治者是本兰斯大人。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'不用我说他们也明白。' R '那两个人可不像我这么' R '笨。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'也就是说，你这家伙才是最危险的' R '存在啊。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'我在那两个人面前抬不起头，' R '所以没事的。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'哈哈哈哈哈哈。' R '你挺起胸膛说这种话，反而更' R '丢人哦。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'哈哈哈，在你面前耍帅' R '也没用啊。' R '我无所谓。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'话就这些。' R '退下吧。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'啊……好。'
		\L_08e21:
		'……那么，接着刚才的话……' R '我哪里迟钝了……'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'哎呀，吵死了，吵死了。'
		\L_08e21:
		\L_08e14:
		!VAR516 : 0!
		%#M.ADV:
		%0:
	}
	{VAR690 = 2:
		!VAR516 : 0!
		%#M.ADV:
		!VAR516 : 1046!
		\L_08df8:
		!VAR516 : 1!
		\L_08d50:
		!VAR516 : 423!
		\L_08dc0:
		\L_08d34:
		ZM 32:
		'利萨斯城' R
		ZM 24:
		R
		'谒见之间'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'你找我有事吗？' R '利萨斯王。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'哦。' R '没事的话，我才不会叫' R '你这种臭男人来。'
		\L_08e21:
		'怎么样？' R '在享受皇帝生活' R '吗？'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'怎么可能。' R '我正时刻准备着，等你下达' R '出击命令，随时待命' R '呢。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'那挺好。'
		\L_08e21:
		'不过，你毕竟是把一个国家' R '托付给我了。' R '作为最高统治者，最低限度的' R '工作还是要做的。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'那种事我最不擅长了' R '啊……' R '要是有什么诀窍，我倒想' R '请你教教我……'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'哈哈哈哈哈哈。' R '像我这样的完美国王' R '可没有这种烦恼……'
		\L_08e21:
		'是啊……俗话说，让专业的人做专业的事，' R '政治还是交给政客去搞' R '比较好。'
		\L_08e21:
		\L_08e14:
		\L_08d34:
		'兰斯说完，玛莉丝在身后' R '连连点头。'
		\L_08e21:
		'于是巴顿理解了这个国家的' R '权力关系。'
		\L_08e21:
		\L_08e14:
		\L_08d88:
		'……也就是说，和以前一样就行了吗……'
		\L_08e21:
		\L_08e14:
		!VAR516 : 0!
		%#M.ADV:
		%0:
	}
	{VAR690 = 3:
		!VAR516 : 0!
		%#M.ADV:
		!VAR516 : 1046!
		\L_08df8:
		!VAR516 : 1!
		\L_08d50:
		!VAR516 : 423!
		\L_08dc0:
		\L_08d34:
		ZM 32:
		'利萨斯城' R
		ZM 24:
		R
		'谒见之间'
		\L_08e21:
		'巴顿明明就在兰斯眼前，' R '兰斯却东张西望' R '。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'怎么了？' R '利萨斯王。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'没什么……我只是在想，平时总在你身边的那' R '个女孩去哪儿了……'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'那个女孩……？' R '啊……'
		\L_08e21:
		\L_08e14:
		\L_08d88:
		'说起来，弗里克说过利萨斯' R '王喜欢女人来着……'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'一直跟在你身边的那个卡拉' R '，是从哪儿弄来的？' R '黑发的卡拉，我从来没见过' R '。'
		\L_08e21:
		\L_08e14:
		\L_08d88:
		'哎呀呀……' R '你居然把那家伙当女人看吗……' R '……心情真复杂……'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'你是说汉蒂吗？'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'她叫这个名字吗？' R '好名字。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'……………'
		\L_08e21:
		'那家伙在我懂事的时候' R '就已经在我身边了。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'？？？'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'好像是我母亲拜托她做我的' R '［贴身护卫］。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'那个女孩，做王族的贴身护卫……' R '她有那么强吗？' R '魔法战士大多半吊子，没什么' R '了不起的家伙……'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'因为她知道我们无法想象的世界和' R '时间……' R '人类水平根本不是她的对手，' R '这一点是肯定的。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'虽然长寿，但成长缓慢的卡拉' R '……而且，还很强……'
		\L_08e21:
		'也就是说……' R '她多大了？' R '从你母亲那一代就开始交往' R '的话……'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'和我母亲一起的肖像画里，画着的汉蒂和现在' R '一模一样……'
		\L_08e21:
		'而且……' R '汉蒂还说过，她和弗里克一直是' R '朋友……'
		\L_08e21:
		'弗里克……确实……嗯……' R '已经超过７００岁了……然后……'
		\L_08e21:
		'听说弗里克遇到汉蒂的时候，她' R '就已经是成年的模样' R '了……'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'……那么……' R '搞不好，比爷爷还……'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'………………'
		\L_08e21:
		'是啊……' R '你要是有勇气问，就去' R '问问看怎么样……'
		\L_08e21:
		'不过，我还是算了。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'怎么，你怕了？'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'……怕。'
		\L_08e21:
		'从我还裹着尿布的时候就在一起的' R '女人……她有多可怕，用语言' R '是说不清的……'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'比玛莉丝还可怕吗？' R '玛莉丝有时候也很可怕。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'诶………'
		\L_08e21:
		\L_08e14:
		\L_08dce:
		!VAR516 : 6!
		\L_08dc0:
		\L_08d6c:
		'……………'
		\L_08e21:
		\L_08e14:
		\L_08d34:
		'玛莉丝虽然装出一副没在听他们说话' R '的样子……'
		\L_08e21:
		\L_08e14:
		\L_08dce:
		!VAR516 : 423!
		\L_08dc0:
		\L_08d6c:
		'啊……啊，对了！' R '我想起还有事！' R '那么，利萨斯王，告辞！'
		\L_08e21:
		\L_08e14:
		\L_08dce:
		!VAR516 : 6!
		\L_08dc0:
		\L_08d34:
		'巴顿匆匆忙忙地' R '离开了。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'什么啊……真是个奇怪的家伙。' R '玛莉丝。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'不知道。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'……战战兢兢……' R '总觉得好可怕……'
		\L_08e21:
		\L_08e14:
		!VAR516 : 0!
		%#M.ADV:
		%0:
	}
	{VAR690 = 4:
		!VAR516 : 0!
		%#M.ADV:
		!VAR516 : 1046!
		\L_08df8:
		!VAR516 : 1!
		\L_08d50:
		!VAR516 : 423!
		\L_08dc0:
		\L_08d34:
		ZM 32:
		'利萨斯城' R
		ZM 24:
		R
		'谒见之间'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'你叫我？'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'哦，来了来了。' R '我正等着你呢。' R '快，快过来。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'怎么了……？'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'嗯，其实……'
		\L_08e21:
		'这件事我太在意了，在意得' R '都睡不着觉了。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'……？？'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'其实啊……'
		\L_08e21:
		'你有没有问过汉蒂关于她头发颜色' R '的事？'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'………………'
		\L_08e21:
		'啊？' R '你就为这个烦恼到睡不着觉' R '吗？'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'啊，没错。' R '我一在意起来就会这样。' R '所以快告诉我。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'啊……头发的事……'
		\L_08e21:
		'……我没问过……'
		\L_08e21:
		'利萨斯王，你老是打听汉蒂的事，' R '难道你对那家伙' R '有意思？'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'可爱的女孩子我都在意。' R '那孩子是你的女人吧？'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'……假、假如她是我的女人，' R '你想怎样？'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'哈哈哈哈哈哈。' R '那还用说。' R '当然是抢过来。'
		\L_08e21:
		'现在的话，我还可以和平地跟你谈。' R '把她让给我。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'正如你所看到的，我没有那家伙' R '就什么都做不了。' R '所以说……'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'那种事……你是皇帝吧。' R '不管是１０个还是１００个，雇' R '女仆不就行了。' R '所以，给我。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'不……女仆的话……没法当我的对手' R '……那个……还得陪我修行' R '才行……那个……怎么说' R '……各种方面……'
		\L_08e21:
		'对对。'
		\L_08e21:
		'而且，那家伙是个野丫头。' R '对利萨斯王来说，更文静' R '的女孩才配得上。' R '嗯嗯。'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'够了，明白了，明白了。' R '是你的女人吧，坦率地那么' R '说不就好了。' R '别那么拼命。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'不，那家伙是……'
		\L_08e21:
		\L_08e14:
		\L_08cfc:
		'别担心，已经够了。' R '真是的，太可怜了，连夺走' R '的念头都没了……'
		\L_08e21:
		'嗯，毕竟只有一个人，' R '没办法啊。' R '哈哈哈哈哈哈。'
		\L_08e21:
		\L_08e14:
		\L_08d6c:
		'………………'
		\L_08e21:
		\L_08e14:
		!VAR516 : 0!
		%#M.ADV:
		%0:
	}
*L_02cca:
	!VAR444 : 1!
	!VAR158 : 52!
	!VAR45 : VAR142!
	!VAR46 : VAR143!
	!VAR516 : 1!
	%#M.ADV:
	!VAR43 : VAR45!
	!VAR44 : VAR46!
	!VAR516 : 10!
