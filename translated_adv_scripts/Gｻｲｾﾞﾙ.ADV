	\L_0571d:
	!VAR516 : 428!
	\L_05675:
	\L_05659:
	ZM 32:
	'利萨斯城' R
	ZM 24:
	R
	'上空'
	\L_05746:
	'赛泽尔漂浮在那里。'
	\L_05746:
	'只是漂浮着。' R '就像被引力牵引着一样……'
	\L_05746:
	\L_05739:
	\L_05683:
	\L_05659:
	'同一时刻……'
	\L_05746:
	ZM 32:
	'利萨斯城' R
	ZM 24:
	R
	'特别室'
	\L_05746:
	\L_05739:
	!VAR516 : 429!
	\L_05675:
	!VAR154 : 2!
	{VAR102 \ 0:
		!VAR516 : 2!
		\L_056e5:
		\L_05691:
		'骗人……不要……' R '怎么办……'
		\L_05746:
		\L_05739:
		\L_05659:
		'希露一直在看护哈泽尔' R '，但大约一小时前，哈泽尔突然' R '变得像人偶一样' R '。'
		\L_05746:
		\L_05739:
		\L_05691:
		'为什么……' R '加油啊……' R '哈泽尔小姐……'
		\L_05746:
		\L_05739:
		\L_05659:
		'希露用冷水浸湿的毛巾' R '擦拭哈泽尔的脸。'
		\L_05746:
		\L_05739:
		\L_05691:
		'……诶……！？'
		\L_05746:
		\L_05739:
		\L_05659:
		'希露手中的毛巾' R '掉了下来。'
		\L_05746:
		'哈泽尔的身体无声地浮起' R '，然后展开了翅膀' R '。'
		\L_05746:
		\L_05739:
		\L_05691:
		'哈……哈泽尔小姐？'
		\L_05746:
		\L_05739:
		\L_05659:
		'哈泽尔的眼神空洞，不像是' R '有意识的样子。'
		\L_05746:
		'但是，就像有意志一般' R '，哈泽尔飞了起来。'
		\L_05746:
		\L_05739:
		\L_05691:
		'哈泽尔小姐！！'
		\L_05746:
		\L_05739:
		\L_05659:
		'哈泽尔冲出房间' R '，朝着利萨斯城的上空飞去。'
		\L_05746:
		\L_05739:
	}
	{VAR102 = 0:
		!VAR516 : 36!
		\L_056e5:
		\L_05691:
		'哈泽尔大人……' R '您怎么样？' R '我给您送饭来了。' R '您能吃东西吗？'
		\L_05746:
		\L_05739:
		\L_05659:
		'温蒂带着为哈泽尔准备的' R '饭菜来到了房间' R '。'
		\L_05746:
		\L_05739:
		\L_05691:
		'………？'
		\L_05746:
		\L_05739:
		\L_05659:
		'温蒂把饭菜放在桌上' R '，走到样子奇怪的哈泽尔身边' R '。'
		\L_05746:
		\L_05739:
		\L_05691:
		'哈泽尔……大人？'
		\L_05746:
		\L_05739:
		\L_05659:
		'哈泽尔的眼睛睁着。' R '但是，什么都没在看。' R '甚至不确定是否还在呼吸。'
		\L_05746:
		\L_05739:
		\L_05691:
		'哈……哈泽尔大人！？' R '请振作一点！' R '哈泽尔大人！？'
		\L_05746:
		\L_05739:
		\L_05659:
		'慌张的温蒂摇晃着哈泽尔的' R '肩膀。'
		\L_05746:
		\L_05739:
		\L_05691:
		'啊……呀！？'
		\L_05746:
		\L_05739:
		\L_05659:
		'哈泽尔的身体浮了起来' R '，然后翅膀缓缓展开' R '。'
		\L_05746:
		\L_05739:
		\L_05691:
		'哈泽尔大人！'
		\L_05746:
		\L_05739:
		\L_05659:
		'仿佛听不到温蒂的呼喊' R '一般……' R '哈泽尔朝着利萨斯城的上空' R '飞走了。'
		\L_05746:
		\L_05739:
	}
	!VAR516 : 428!
	\L_05675:
	!VAR516 : 429!
	\L_056e5:
	\L_05659:
	'赛泽尔在那里。'
	\L_05746:
	'哈泽尔过来了。'
	\L_05746:
	'明明是久违重逢的姐妹……' R '两人的表情却毫无变化。'
	\L_05746:
	'然后，慢慢地……' R '如同磁石相互吸引一般，' R '彼此的身体相互吸引。'
	\L_05746:
	'然后……'
	\L_05746:
	'融合……'
	\L_05746:
	\L_05739:
	SS 19:
	PW1 VAR56:
	\L_05683:
	\L_056f3:
	PW0 VAR56:
	!VAR516 : 461!
	\L_05675:
	\L_05659:
	'赛泽尔不在了。' R '哈泽尔不在了。'
	\L_05746:
	'赛泽尔存在。' R '哈泽尔存在。'
	\L_05746:
	'两人合为一人。' R '化为虚无的存在。'
	\L_05746:
	'然后，成为破坏的象征……'
	\L_05746:
	!VAR154 : 29!
	{VAR102 \ 0:
		\L_05739:
		\L_05683:
		!VAR516 : 1!
		\L_05675:
		!VAR516 : 75!
		\L_056e5:
		\L_05691:
		'兰斯……'
		\L_05746:
		\L_05739:
		\L_05621:
		'那是什么……？'
		\L_05746:
		\L_05739:
		\L_05659:
		'已经察觉到异变的兰斯' R '叫来萨特拉，两人一起' R '凝视着上空之物。'
		\L_05746:
		\L_05739:
		\L_05691:
		'拉·巴斯瓦尔德……'
		\L_05746:
		\L_05739:
		\L_05621:
		'那是什么？'
		\L_05746:
		\L_05739:
		\L_05691:
		'萨特拉也只是在传说中' R '得知……是破坏与虚无之神。' R '只为破坏而存在的，行走的兵器。'
		\L_05746:
		\L_05739:
		\L_05621:
		'那就是……吗？'
		\L_05746:
		\L_05739:
		\L_05691:
		'没错……'
		\L_05746:
		'说白了……' R '麻烦的家伙出现了……' R '只有这一点，是确凿' R '无疑的。'
		\L_05746:
		\L_05739:
		\L_05621:
		'………………'
		\L_05746:
		\L_05739:
	}
	{VAR102 = 0:
		'破坏与虚无之神。' R '不像萨特拉、凯布里斯' R '等魔人那样拥有人格。'
		\L_05746:
		'她存在的理由，仅仅是' R '破坏。' R '如同兵器一般的存在理由。'
		\L_05746:
		'而那就是……' R '她们被一分为二的' R '原因……'
		\L_05746:
		\L_05739:
	}
