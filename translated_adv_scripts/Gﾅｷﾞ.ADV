		\L_0bc36:
		!VAR516 : 75!
		\L_0bb72:
		\L_0bb1e:
		'吵死了……' R '我正在思考新型守护者的事，' R '别发什么奇怪的念波' R '过来啊……'
		\L_0bc43:
		\L_0bc36:
