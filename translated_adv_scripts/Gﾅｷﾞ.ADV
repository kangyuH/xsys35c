		\L_0bc36:
		\L_0bb1e:
		'嗯……' R '什么啊，一大清早的……' R '我可没听见那种东西。' R '你不是睡迷糊了吧？'
		\L_0bc43:
		\L_0bc36:
		\L_0bb8e:
		'所以说，只有魔法使才……' R '总之我们去看看吧，' R '志津香小姐她……'
		\L_0bc43:
		\L_0bc36:
		\L_0bb1e:
		'嗯——，两天后吗……' R '有空的话，就去看看吧。'
		\L_0bc43:
		\L_0bc36:
		\L_0bb8e:
		'兰斯大人……'
		\L_0bc43:
		\L_0bc36:
	}
